// Deployed by Cloudflare Workers Builds (the dashboard's Git connection), not
// by a GitHub Actions workflow: root directory `site`, build command
// `npm ci && npm run build`, deploy command `npx wrangler deploy`. Branches
// other than `main` build as previews, whose URL the Cloudflare GitHub App
// comments on the pull request. Keep these three settings and this file in
// sync — the dashboard is the only place the other two live.
{
  "name": "holt",
  "account_id": "33cb12c112241599f30db76874a7ecbb",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    // Multi-page site: unknown paths 404 instead of falling back to /index.html.
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "persist": true
    }
  }
}
