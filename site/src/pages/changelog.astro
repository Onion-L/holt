---
import ChangelogController from '../components/ChangelogController';
---

<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Holt — Changelog</title>
<meta name="description" content="Every Holt release: features and fixes, version by version." />
<link rel="icon" type="image/png" href="/assets/favicon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Geist:wght@400;700&family=Geist+Mono:wght@500&family=Instrument+Serif:ital@1&display=swap" rel="stylesheet" />
<style is:inline>
  *, *::before, *::after { box-sizing: border-box; }
  :root {
    --ink: #17233b; --cream: #f6f1e6; --paper: #fffdf8;
    --blue: #0a4c9c; --deep: #072f66; --pink: #e34d83; --grey: #8a867c; --line: rgba(23,35,59,.14);
  }
  html, body { margin: 0; }
  body {
    font-family: Geist, -apple-system, BlinkMacSystemFont, sans-serif;
    -webkit-font-smoothing: antialiased; color: var(--ink);
    background: var(--cream);
  }
  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 2px solid var(--pink); outline-offset: 3px; }
  .mono { font-family: "Geist Mono", Menlo, monospace; }

  .wrap { width: min(var(--ww, 760px), 100% - 32px); margin: 0 auto; padding-bottom: 90px; }
  .vers { list-style: none; margin: 0; padding: 0; }
  .vcol ul { margin: 0; padding: 0; list-style: none; }
  .vcol li { position: relative; }

  /* shared topbar */
  .topbar { display: flex; justify-content: flex-end; align-items: center; font-size: 12px; letter-spacing: .08em; }
  .topbar nav { display: flex; gap: 22px; text-transform: uppercase; color: #5b6472; }
  .topbar nav a { border-bottom: 1px solid transparent; padding-bottom: 2px; }
  .topbar nav a:hover { color: var(--blue); border-color: var(--blue); }

  /* shared head text */
  .thead p { margin: 0; font-size: 11.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--grey); }
  .thead p b { color: var(--blue); font-weight: 500; }

  /* shared +/– semantics (restyled per variant) */
  .f .cat { color: var(--pink); }
  .f li::before { content: "+"; color: var(--pink); }
  .x li::before { content: "–"; color: var(--grey); }

  .foot { text-align: center; margin-top: 60px; font-size: 11.5px; color: var(--grey); letter-spacing: .04em; }
  .foot a { text-decoration: underline; text-underline-offset: 3px; }
  .foot a:hover { color: var(--blue); }

  /* ============ D — Coast road ============ */
  [data-variant="d"] {
    --ww: 860px;
    background: linear-gradient(180deg, #b9d9f0 0%, #e9f4fb 320px, var(--cream) 720px);
  }
  [data-variant="d"] .topbar { padding: 26px 2px; width: min(860px, 100% - 32px); margin: 0 auto; }
  [data-variant="d"] .thead { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin: 14px 0 36px; }
  [data-variant="d"] .thead h1 { margin: 0; font: 700 clamp(44px, 6.5vw, 68px)/0.95 Geist, sans-serif; letter-spacing: -.045em; }
  [data-variant="d"] .thead h1 span { color: var(--pink); }
  [data-variant="d"] .vers { position: relative; padding-left: 36px; }
  [data-variant="d"] .vers::before { content: ""; position: absolute; left: 7px; top: 6px; bottom: 6px; border-left: 2px dashed rgba(10,76,156,.45); }
  [data-variant="d"] .ver {
    position: relative; background: var(--paper); border: 1px solid var(--line); border-radius: 14px;
    padding: 22px 26px 24px; margin-bottom: 20px; box-shadow: 0 12px 32px -20px rgba(23,35,59,.35);
  }
  [data-variant="d"] .ver::before {
    content: ""; position: absolute; left: -34px; top: 30px; width: 11px; height: 11px; border-radius: 50%;
    background: var(--pink); border: 2.5px solid #fff; box-shadow: 0 0 0 2px rgba(10,76,156,.35);
  }
  [data-variant="d"] .vhead { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px 16px; }
  [data-variant="d"] .vnum { font: 700 26px/1 Geist, sans-serif; letter-spacing: -.03em; color: var(--blue); }
  [data-variant="d"] .vnum:hover { color: var(--pink); }
  [data-variant="d"] .vdate { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--grey); }
  [data-variant="d"] .stamp { margin-left: auto; align-self: center; padding: 3px 10px; border: 1.5px solid var(--pink); border-radius: 999px; color: var(--pink); font-size: 9px; letter-spacing: .12em; text-transform: uppercase; }
  [data-variant="d"] .vgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 10px 40px; margin-top: 16px; }
  [data-variant="d"] .cat { margin: 0 0 9px; font-size: 10.5px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; }
  [data-variant="d"] .x .cat { color: #5b6472; }
  [data-variant="d"] .cat::before { margin-right: .6em; }
  [data-variant="d"] .f .cat::before { content: "+"; }
  [data-variant="d"] .x .cat::before { content: "–"; }
  [data-variant="d"] .vcol li { padding-left: 16px; margin-bottom: 7px; font: 500 12.5px/1.55 "Geist Mono", Menlo, monospace; color: #3c4658; }
  [data-variant="d"] .vcol li::before { position: absolute; left: 0; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition-duration: 0s !important; animation-duration: 0s !important; }
  }
</style>
</head>
<body data-variant="d">

<div class="topbar mono">
  <nav>
    <a href="/">← Back</a>
    <a href="https://github.com/Onion-L/holt">GitHub ↗</a>
  </nav>
</div>

<div class="wrap">
  <div class="thead">
    <h1>Changelog<span>.</span></h1>
  </div>

  <ol class="vers">

    <li class="ver" id="v0.5.1">
      <div class="vhead">
        <a class="vnum" href="https://github.com/Onion-L/holt/releases/tag/v0.5.1">0.5.1</a>
        <span class="vdate mono">Oct 13, 2026</span>
        <span class="stamp mono">current</span>
      </div>
      <div class="vgrid">
        <section class="vcol f">
          <h3 class="cat mono">Features</h3>
          <ul>
            <li>RPC failures carry typed error codes — diff, restore, and proposal errors classify by code instead of matching display text</li>
            <li>Plan mode submits through submit_plan: the plan rides structured data into the approval card, with the &lt;proposed_plan&gt; text convention kept as a fallback</li>
            <li>Landing page rebuilt on Astro, with a chip-aware download button</li>
          </ul>
        </section>
        <section class="vcol x">
          <h3 class="cat mono">Fixes</h3>
          <ul>
            <li>The auto-review verdict matches as a clean whole word — a longer word containing it no longer counts</li>
            <li>The release workflow retries DMG detach when the volume is busy</li>
          </ul>
        </section>
      </div>
    </li>

    <li class="ver" id="v0.5.0">
      <div class="vhead">
        <a class="vnum" href="https://github.com/Onion-L/holt/releases/tag/v0.5.0">0.5.0</a>
        <span class="vdate mono">Oct 12, 2026</span>
      </div>
      <div class="vgrid">
        <section class="vcol f">
          <h3 class="cat mono">Features</h3>
          <ul>
            <li>Goal mode: /goal &lt;objective&gt; arms a verified objective loop that keeps the agent working at Turn settle</li>
            <li>The goal card rides the composer, folded to its glyph and phase, and shows what the loop is doing between and during Turns</li>
            <li>Goal continuations draw as loop rows instead of user bubbles; the sent objective chips inline in the transcript</li>
            <li>A configurable cross-provider goal verifier model</li>
            <li>Plan and provider modes ride slash directives, with a top-right state card</li>
          </ul>
        </section>
        <section class="vcol x">
          <h3 class="cat mono">Fixes</h3>
          <ul>
            <li>The goal loop stays alive through verifier failures and pauses when a round fails to enqueue</li>
            <li>A /goal send with path refs keeps its chip and hides the marker</li>
            <li>The goal band joins the turn&rsquo;s footer strip without claiming a prompt&rsquo;s or another band&rsquo;s</li>
          </ul>
        </section>
      </div>
    </li>

    <li class="ver" id="v0.4.2">
      <div class="vhead">
        <a class="vnum" href="https://github.com/Onion-L/holt/releases/tag/v0.4.2">0.4.2</a>
        <span class="vdate mono">Oct 11, 2026</span>
      </div>
      <div class="vgrid">
        <section class="vcol x">
          <h3 class="cat mono">Fixes</h3>
          <ul>
            <li>Replaying a compacted chat no longer re-inflates the context with the summarized prefix on every restart</li>
            <li>Occupancy falls after a compaction instead of holding the pre-compaction number, and the next turn no longer fires a redundant compaction</li>
            <li>First open no longer stalls on boot-time image reconciliation</li>
            <li>All Mermaid diagram families theme with the app instead of leaking base-theme defaults</li>
          </ul>
        </section>
      </div>
    </li>

    <li class="ver" id="v0.4.1">
      <div class="vhead">
        <a class="vnum" href="https://github.com/Onion-L/holt/releases/tag/v0.4.1">0.4.1</a>
        <span class="vdate mono">Oct 09, 2026</span>
      </div>
      <div class="vgrid">
        <section class="vcol f">
          <h3 class="cat mono">Features</h3>
          <ul>
            <li>Sidebar toggle glyphs morph with the pane width tweens</li>
            <li>Update dialog widened, with the Holt logo in its header</li>
          </ul>
        </section>
        <section class="vcol x">
          <h3 class="cat mono">Fixes</h3>
          <ul>
            <li>Write/edit approvals bind to the same normalized path the tool writes — an approved card could name a different file than the one written</li>
            <li>Deeply nested streamed tool-call JSON no longer overflows the stack</li>
            <li>&lt;proposed_plan&gt; quoted in an ordinary reply renders as text instead of spawning an inert approval card</li>
          </ul>
        </section>
      </div>
    </li>

    <li class="ver" id="v0.4.0">
      <div class="vhead">
        <a class="vnum" href="https://github.com/Onion-L/holt/releases/tag/v0.4.0">0.4.0</a>
        <span class="vdate mono">Oct 09, 2026</span>
      </div>
      <div class="vgrid">
        <section class="vcol f">
          <h3 class="cat mono">Features</h3>
          <ul>
            <li>The agent core (pi-core-rs) lives in-tree as crates/core — engine and agent loop build and test as one workspace</li>
          </ul>
        </section>
        <section class="vcol x">
          <h3 class="cat mono">Fixes</h3>
          <ul>
            <li>A lost compaction record self-heals on replay instead of failing the chat</li>
            <li>Mermaid diagrams no longer snap smaller while zooming in; the Fit button no longer sits next to the zoom-in button</li>
          </ul>
        </section>
      </div>
    </li>

    <li class="ver" id="v0.3.0">
      <div class="vhead">
        <a class="vnum" href="https://github.com/Onion-L/holt/releases/tag/v0.3.0">0.3.0</a>
        <span class="vdate mono">Oct 08, 2026</span>
      </div>
      <div class="vgrid">
        <section class="vcol f">
          <h3 class="cat mono">Features</h3>
          <ul>
            <li>Routines: scheduled prompts fire on their cron — routine cards on a Scheduled page, run outcomes recorded, waiting runs notify</li>
            <li>Missed fires coalesce into one catch-up run; overlapping fires skip and can pause the Routine</li>
            <li>One-time Routines via the Custom schedule; the schedule form has a calendar date picker and previews fires in the Routine&rsquo;s own time zone</li>
            <li>Chat manager gains a run chat caption, Recent folding, and a filter</li>
            <li>The titlebar keeps new-session on every route; Scheduled and Chat manager move into the chrome</li>
          </ul>
        </section>
        <section class="vcol x">
          <h3 class="cat mono">Fixes</h3>
          <ul>
            <li>Compaction truncates at char boundaries; a panicking run downcasts its payload correctly</li>
            <li>Fire claims are a single write and re-check pause; obsolete scheduled fires are discarded</li>
            <li>A removed Space auto-pauses its Routines; a missing model fails the run</li>
          </ul>
        </section>
      </div>
    </li>

    <li class="ver" id="v0.2.8">
      <div class="vhead">
        <a class="vnum" href="https://github.com/Onion-L/holt/releases/tag/v0.2.8">0.2.8</a>
        <span class="vdate mono">Oct 06, 2026</span>
      </div>
      <div class="vgrid">
        <section class="vcol f">
          <h3 class="cat mono">Features</h3>
          <ul>
            <li>The update disc opens a dialog — confirm the download, watch byte progress, cancel before the install starts, then restart when ready</li>
            <li>About Holt opens an in-app dialog with the app logo and version</li>
          </ul>
        </section>
      </div>
    </li>

    <li class="ver" id="v0.2.7">
      <div class="vhead">
        <a class="vnum" href="https://github.com/Onion-L/holt/releases/tag/v0.2.7">0.2.7</a>
        <span class="vdate mono">Oct 05, 2026</span>
      </div>
      <div class="vgrid">
        <section class="vcol f">
          <h3 class="cat mono">Features</h3>
          <ul>
            <li>Turn change card reworked after the reference layout — file list folds from its header, counts sit in fixed lanes, file names stay visible</li>
            <li>A whole-Turn restore reports its outcome on the card, and the restored card fades into history</li>
          </ul>
        </section>
        <section class="vcol x">
          <h3 class="cat mono">Fixes</h3>
          <ul>
            <li>Branches re-list when a Turn ends or the window regains focus</li>
          </ul>
        </section>
      </div>
    </li>

    <li class="ver" id="v0.2.6">
      <div class="vhead">
        <a class="vnum" href="https://github.com/Onion-L/holt/releases/tag/v0.2.6">0.2.6</a>
        <span class="vdate mono">Oct 05, 2026</span>
      </div>
      <div class="vgrid">
        <section class="vcol f">
          <h3 class="cat mono">Features</h3>
          <ul>
            <li>A Turn's change card restores the files it touched — hash-gated writes, with a report when later Turns changed the same files</li>
            <li>Referenced paths lift into removable chips in queue rows, the queue editor, and the inline message editor</li>
          </ul>
        </section>
        <section class="vcol x">
          <h3 class="cat mono">Fixes</h3>
          <ul>
            <li>Removing a provider clears its entries for good</li>
            <li>Vibrancy colorSaturate stays applied and the dark glass scrim lightens</li>
            <li>Site version fallbacks show a placeholder instead of a stale number</li>
          </ul>
        </section>
      </div>
    </li>

    <li class="ver" id="v0.2.5">
      <div class="vhead">
        <a class="vnum" href="https://github.com/Onion-L/holt/releases/tag/v0.2.5">0.2.5</a>
        <span class="vdate mono">Oct 04, 2026</span>
      </div>
      <div class="vgrid">
        <section class="vcol x">
          <h3 class="cat mono">Fixes</h3>
          <ul>
            <li>A damaged history line no longer amplifies into a duplicate tool result that breaks every later Turn in the chat</li>
            <li>Release signing pins its third-party workflow actions to commit SHAs</li>
          </ul>
        </section>
      </div>
    </li>

    <li class="ver" id="v0.2.4">
      <div class="vhead">
        <a class="vnum" href="https://github.com/Onion-L/holt/releases/tag/v0.2.4">0.2.4</a>
        <span class="vdate mono">Oct 04, 2026</span>
      </div>
      <div class="vgrid">
        <section class="vcol x">
          <h3 class="cat mono">Fixes</h3>
          <ul>
            <li>The turn change card opens collapsed — expand it when you want the diff</li>
            <li>The queue panel no longer flashes on ordinary sends</li>
          </ul>
        </section>
      </div>
    </li>

    <li class="ver" id="v0.2.3">
      <div class="vhead">
        <a class="vnum" href="https://github.com/Onion-L/holt/releases/tag/v0.2.3">0.2.3</a>
        <span class="vdate mono">Oct 04, 2026</span>
      </div>
      <div class="vgrid">
        <section class="vcol x">
          <h3 class="cat mono">Fixes</h3>
          <ul>
            <li>A failed save (disk full, read-only storage) no longer wedges a chat until restart — the fence now spans one run attempt and lifts once storage recovers</li>
            <li>A blocked retry is refused before any model call and parks the message with the actionable storage error instead of dropping it</li>
            <li>Queue failures report the reason that caused them, not a stale save error</li>
          </ul>
        </section>
      </div>
    </li>

    <li class="ver" id="v0.2.2">
      <div class="vhead">
        <a class="vnum" href="https://github.com/Onion-L/holt/releases/tag/v0.2.2">0.2.2</a>
        <span class="vdate mono">Oct 03, 2026</span>
      </div>
      <div class="vgrid">
        <section class="vcol f">
          <h3 class="cat mono">Features</h3>
          <ul>
            <li>Editing a pruned turn retracts its change set</li>
            <li>Chat manager titlebar icon swapped for the Solar inbox glyph</li>
          </ul>
        </section>
        <section class="vcol x">
          <h3 class="cat mono">Fixes</h3>
          <ul>
            <li>Markdown nesting depth capped, over-limit containers degrade to text</li>
            <li>Model probe body aborts at its cap</li>
          </ul>
        </section>
      </div>
    </li>

    <li class="ver" id="v0.2.1">
      <div class="vhead">
        <a class="vnum" href="https://github.com/Onion-L/holt/releases/tag/v0.2.1">0.2.1</a>
        <span class="vdate mono">Oct 02, 2026</span>
      </div>
      <div class="vgrid">
        <section class="vcol f">
          <h3 class="cat mono">Features</h3>
          <ul>
            <li>Superseded cards render as one muted line</li>
            <li>Git panel drops the status view and hosts only the commit graph</li>
          </ul>
        </section>
        <section class="vcol x">
          <h3 class="cat mono">Fixes</h3>
          <ul>
            <li>Bold renders correctly around fullwidth CJK punctuation</li>
            <li>Bash always-allow grants are scoped to plain-argument word prefixes</li>
          </ul>
        </section>
      </div>
    </li>

    <li class="ver" id="v0.2.0">
      <div class="vhead">
        <a class="vnum" href="https://github.com/Onion-L/holt/releases/tag/v0.2.0">0.2.0</a>
        <span class="vdate mono">Oct 02, 2026</span>
      </div>
      <div class="vgrid">
        <section class="vcol f">
          <h3 class="cat mono">Features</h3>
          <ul>
            <li>Chat manager page for batch session operations: every chat, search and filters, persistent multi-select, batch archive/unarchive and delete</li>
            <li>Redesigned chat manager rows: compact recency groups, shift-range select, tri-state select-all, floating selection bar, keyboard shortcuts</li>
            <li>Chat manager opens from the titlebar cluster</li>
            <li>Git panel becomes a read-only view: staging and commit actions removed</li>
            <li>Syntax highlight queries compile once per language and are cached</li>
          </ul>
        </section>
        <section class="vcol x">
          <h3 class="cat mono">Fixes</h3>
          <ul>
            <li>Failed batch operations keep their selection so the pass can be retried</li>
            <li>Space filter falls back to All spaces when a space no longer resolves</li>
            <li>Escape cancels the delete confirmation</li>
          </ul>
        </section>
      </div>
    </li>

    <li class="ver" id="v0.1.10">
      <div class="vhead">
        <a class="vnum" href="https://github.com/Onion-L/holt/releases/tag/v0.1.10">0.1.10</a>
        <span class="vdate mono">Oct 01, 2026</span>
      </div>
      <div class="vgrid">
        <section class="vcol f">
          <h3 class="cat mono">Features</h3>
          <ul>
            <li>Agent asks structured questions (ask_user), answered inline in the composer approval bar</li>
            <li>1-4 questions per card, with a pager and clickable page arrows</li>
            <li>Escape dismisses a pending question bar</li>
          </ul>
        </section>
        <section class="vcol x">
          <h3 class="cat mono">Fixes</h3>
          <ul>
            <li>Cache write tile hidden when no usage in range</li>
            <li>Sidebar session rows keep one fixed height</li>
          </ul>
        </section>
      </div>
    </li>

    <li class="ver" id="v0.1.9">
      <div class="vhead">
        <a class="vnum" href="https://github.com/Onion-L/holt/releases/tag/v0.1.9">0.1.9</a>
        <span class="vdate mono">Sep 30, 2026</span>
      </div>
      <div class="vgrid">
        <section class="vcol f">
          <h3 class="cat mono">Features</h3>
          <ul>
            <li>Multiple web search backends: keyless Exa default, custom backends, MCP tools</li>
            <li>Home space for project-less chats</li>
            <li>Drag to reorder sidebar sessions, with edge autoscroll</li>
            <li>This changelog page, linked from the poster</li>
          </ul>
        </section>
        <section class="vcol x">
          <h3 class="cat mono">Fixes</h3>
          <ul>
            <li>MCP stdio commands resolve against login shell PATH</li>
            <li>Workspace writes landing through a symlink are refused</li>
          </ul>
        </section>
      </div>
    </li>

    <li class="ver" id="v0.1.8">
      <div class="vhead">
        <a class="vnum" href="https://github.com/Onion-L/holt/releases/tag/v0.1.8">0.1.8</a>
        <span class="vdate mono">Sep 28, 2026</span>
      </div>
      <div class="vgrid">
        <section class="vcol f">
          <h3 class="cat mono">Features</h3>
          <ul>
            <li>Custom providers can set their own logo</li>
            <li>Simplified general settings layout</li>
            <li>Tidier provider panel layout</li>
            <li>Headless holt-runner for harness evals</li>
            <li>Click-to-play launch film on the site</li>
          </ul>
        </section>
        <section class="vcol x">
          <h3 class="cat mono">Fixes</h3>
          <ul>
            <li>Long text no longer overflows notice chips</li>
          </ul>
        </section>
      </div>
    </li>

    <li class="ver" id="v0.1.7">
      <div class="vhead">
        <a class="vnum" href="https://github.com/Onion-L/holt/releases/tag/v0.1.7">0.1.7</a>
        <span class="vdate mono">Sep 28, 2026</span>
      </div>
      <div class="vgrid">
        <section class="vcol x">
          <h3 class="cat mono">Fixes</h3>
          <ul>
            <li>Turn review pane scrolls both axes</li>
            <li>Queued-message edit: overflow, submit guard, and error surface</li>
            <li>Inline message edit: layout, hover, and chrome polish</li>
          </ul>
        </section>
      </div>
    </li>

    <li class="ver" id="v0.1.6">
      <div class="vhead">
