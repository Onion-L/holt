        <!-- HERO IMAGE: full width below nav -->
        <div class="hero-img-wrap">
            <img class="hero-img" src="/assets/hero-astronaut.png" alt="Astronaut above Earth" fetchpriority="high" />
        </div>

        <!-- HERO COPY: two-column below image -->
        <div class="hero-copy">
