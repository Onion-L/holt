---
import HeroController from "../components/HeroController";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Holt is an agent.</title>
        <meta
            name="description"
            content="Holt is a native desktop coding agent for macOS, Windows, and Linux. Every step visible, every line yours to review."
        />
        <meta property="og:title" content="Holt is an agent." />
        <meta
            property="og:description"
            content="A native desktop coding agent for macOS, Windows, and Linux."
        />
        <!-- Crawlers (X, Slack, …) ignore relative URLs; keep these absolute. -->
        <meta
            property="og:url"
            content="https://holt.onionl5236.workers.dev/"
        />
        <meta property="og:type" content="website" />
        <meta
            property="og:image"
            content="https://holt.onionl5236.workers.dev/assets/og.png"
        />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="Holt is an agent." />
        <meta
            name="twitter:description"
            content="A native desktop coding agent for macOS, Windows, and Linux."
        />
        <meta
            name="twitter:image"
            content="https://holt.onionl5236.workers.dev/assets/og.png"
        />
        <meta name="theme-color" content="#121316" />
        <link rel="icon" type="image/png" href="/assets/favicon.png" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500&display=swap"
            rel="stylesheet"
        />
        <style is:inline>
            *, *::before, *::after { box-sizing: border-box; }
            :root {
                --page:  #121316;
                --surface: #1a1c20;
                --ink:   #ece9e2;
                --muted: #979ba3;
                --line:  rgba(255,255,255,.1);
                --coral: #ed9b7f;
                --dk:    #0c0d0f;
                --sans: "Archivo", system-ui, sans-serif;
                --mono: "IBM Plex Mono", monospace;
            }
            html { scroll-behavior: smooth; }
            body { margin: 0; font-family: var(--sans); background: var(--page); color: var(--ink); -webkit-font-smoothing: antialiased; }
            a { color: inherit; text-decoration: none; }
            a:focus-visible { outline: 2px solid var(--coral); outline-offset: 3px; }
            h1,h2,h3,p { margin-top: 0; }
            .icon { display: inline-block; flex-shrink: 0; width: 14px; height: 14px; background: currentColor; -webkit-mask: var(--icon) center/contain no-repeat; mask: var(--icon) center/contain no-repeat; }
            .icon-download { --icon: url("/assets/icons/download.svg"); }
            .icon-up-right { --icon: url("/assets/icons/arrow-up-right.svg"); }

            /* ── NAV — minimal full-width bar ── */
            .nav-wrap {
                padding: 24px clamp(20px,3vw,44px) 0;
            }
            .nav {
                display: flex; align-items: center; gap: clamp(28px,4vw,56px);
                width: 100%;
            }
            .logo { display: inline-flex; align-items: center; gap: 9px; font-size: 20px; font-weight: 900; letter-spacing: -.06em; color: var(--ink); }
            .logo img { width: 28px; height: 28px; border-radius: 6px; }
            .nav-links { display: flex; gap: 32px; font-size: 14px; color: var(--muted); }
            .nav-links a, .nav-icon, .btn-nav { transition: color .15s, opacity .15s; }
            .nav-links a:hover { color: var(--ink); }
            .nav-actions { display: flex; align-items: center; gap: 24px; margin-left: auto; }
            .nav-icon { display: inline-flex; opacity: .6; }
            .nav-icon:hover { opacity: 1; }
            .nav-icon img { width: 20px; height: 20px; }
            .btn-nav { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; color: var(--ink); }
            .btn-nav:hover { color: var(--coral); }

            /* ── HERO IMAGE — full width, moderate height ── */
            .hero-img-wrap {
                position: relative; overflow: hidden;
                margin: 18px clamp(16px,3vw,40px) 0;
                border-radius: 8px;
            }
            .hero-img {
                width: 100%; display: block;
                aspect-ratio: 21/9;
                object-fit: cover; object-position: 50% 30%;
                animation: imgReveal 2.2s cubic-bezier(.22,1,.36,1) both;
            }
            @keyframes imgReveal {
                from { opacity: 0; transform: scale(1.04); }
                to   { opacity: 1; transform: scale(1); }
            }
            /* subtle bottom vignette so copy below reads well */
            .hero-img-wrap::after {
                content: ""; position: absolute; inset: 0; pointer-events: none;
                background: linear-gradient(180deg, transparent 60%, rgba(18,19,22,.18) 100%);
            }

            /* ── HERO COPY — below image, two-column ── */
            .hero-copy {
                display: grid; grid-template-columns: 1fr 1fr;
                gap: clamp(24px,4vw,56px); align-items: center;
                padding: 32px clamp(16px,3vw,40px) 44px;
                animation: copyRise .8s .2s cubic-bezier(.22,1,.36,1) both;
            }
            @keyframes copyRise {
                from { opacity: 0; transform: translateY(12px); }
                to   { opacity: 1; transform: translateY(0); }
            }
            .hero-title {
                margin: 0;
                font-size: clamp(34px, 5.5vw, 84px); line-height: 1; letter-spacing: -.045em; font-weight: 900;
                white-space: nowrap;
            }
            .hero-right { display: flex; flex-direction: column; justify-content: flex-end; gap: 16px; }
            .hero-sub { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.65; }
            .hero-actions { display: flex; gap: 10px; flex-wrap: wrap; }
            .btn {
                display: inline-flex; align-items: center; justify-content: center;
                height: 50px; padding: 0 28px; gap: 8px; border-radius: 999px;
                font-size: 14px; font-weight: 700;
                border: 1px solid transparent;
                transition: transform .15s, background .15s;
                cursor: pointer; align-self: flex-start;
            }
            .btn:hover { transform: translateY(-1px); }
            .btn-dk  { background: var(--coral); color: var(--dk); }
            .btn-dk:hover { background: #f0a58c; }
            .btn-wh  { background: var(--surface); color: var(--ink); border-color: var(--line); }
            .btn-wh:hover { background: #24272c; }
            .btn-gh  { border-color: rgba(255,255,255,.2); color: rgba(255,255,255,.65); }
            .btn-gh:hover { border-color: rgba(255,255,255,.45); color: var(--ink); }

            /* ── PROVIDER BAND ── */
            .band {
                display: flex; align-items: center; flex-wrap: wrap;
                gap: 24px;
                padding: 24px clamp(16px,3vw,40px);
                border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
                margin-bottom: 80px; overflow: hidden;
            }
            .band-lbl { flex-shrink: 0; display: inline-flex; align-items: center; padding-right: 24px; border-right: 1px solid var(--line); font: 500 10px/1 var(--mono); color: #7f858e; letter-spacing: .08em; text-transform: uppercase; }
            .provider-marquee { flex: 1; min-width: 0; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent); mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent); }
            .provider-track { display: flex; width: max-content; animation: providerScroll 120s linear infinite; }
            .provider-group { flex-shrink: 0; display: flex; align-items: center; gap: clamp(28px,3vw,48px); padding-right: clamp(28px,3vw,48px); }
            .provider-marquee:hover .provider-track { animation-play-state: paused; }
            @keyframes providerScroll { to { transform: translateX(-50%); } }
            .provider  { flex-shrink: 0; display: inline-flex; align-items: center; gap: 9px; font-size: 13px; font-weight: 600; color: #a7acb5; letter-spacing: -.02em; transition: color .15s; }
            .provider img { width: 18px; height: 18px; object-fit: contain; filter: grayscale(1) brightness(0) invert(1); opacity: .55; transition: opacity .15s; }
            .provider-mark { display: grid; place-items: center; width: 18px; height: 18px; border: 1px solid currentColor; border-radius: 5px; font: 500 7px/1 var(--mono); opacity: .55; transition: opacity .15s; }
            .provider:hover { color: var(--ink); }
            .provider:hover img, .provider:hover .provider-mark { opacity: .9; }

            /* ── WHY ── */
            .section { max-width: 1280px; margin: 0 auto; padding: 0 clamp(16px,3vw,40px); }
            .why { text-align: center; margin-bottom: 52px; }
            .why h2 { font-size: clamp(28px,4vw,50px); line-height: 1.06; letter-spacing: -.04em; font-weight: 800; margin: 0; }

            /* ── FEATURES ── */
            .features { margin-bottom: 80px; border-bottom: 1px solid var(--line); }
            .fc { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); }
            .fv {
                order: 2; min-height: 380px; background: #17191d;
                display: grid; place-items: center;
                color: #777d87; font-size: 12px; font-weight: 500;
                border-left: 1px solid var(--line);
            }
            .fb { order: 1; padding: clamp(32px,4vw,56px); display: flex; flex-direction: column; justify-content: center; }
            .fn { font: 500 10px/1 var(--mono); color: var(--coral); letter-spacing: .1em; margin-bottom: 20px; }
            .fb h3 { font-size: clamp(28px,3vw,44px); line-height: 1.08; letter-spacing: -.04em; margin-bottom: 20px; }
            .fb p  { color: var(--muted); font-size: 14px; line-height: 1.75; max-width: 400px; margin: 0 0 28px; }
            .tags  { display: flex; gap: 6px; flex-wrap: wrap; }
            .tag   { padding: 4px 9px; border: 1px solid var(--line); border-radius: 999px; font: 400 9px/1 var(--mono); color: #9fa4ae; }

            /* ── CTA ── */
            .cta {
                border-radius: 10px; padding: clamp(40px,5vw,64px) clamp(28px,4vw,56px);
                background: var(--dk); color: var(--ink);
                display: flex; align-items: center; justify-content: space-between; gap: 24px;
                margin-bottom: 28px;
            }
            .cta h2 { margin: 0; font-size: clamp(24px,3.4vw,42px); line-height: 1.06; letter-spacing: -.04em; }
            .cta-actions { display: flex; gap: 10px; flex-shrink: 0; }

            /* ── FOOTER ── */
            footer {
                border-top: 1px solid var(--line);
                display: flex; justify-content: space-between; align-items: center;
                padding: 22px 0 36px; color: #8b9099; font: 400 11px/1.5 var(--mono);
            }
            .fl { display: flex; gap: 22px; }
            .fl a:hover { color: var(--muted); }

            /* ── RESPONSIVE ── */
            @media (max-width: 820px) {
                .nav-links { display: none; }
                .hero-copy { grid-template-columns: 1fr; gap: 20px; }
                .band-lbl { width: 100%; justify-content: center; padding-right: 0; border-right: 0; }
                .hero-img { aspect-ratio: 16/9; }
                .fc { grid-template-columns: 1fr; }
                .fv { min-height: 260px; border-left: 0; border-top: 1px solid var(--line); }
                .cta { flex-direction: column; align-items: flex-start; }
            }
            @media (max-width: 520px) {
                footer { flex-direction: column; align-items: flex-start; gap: 12px; padding-bottom: 48px; }
                .cta-actions { flex-direction: column; width: 100%; }
            }
            @media (prefers-reduced-motion: reduce) {
                .hero-img, .hero-copy, .provider-track { animation: none; }
            }
        </style>
    </head>
    <body>
        <!-- NAV: full-width minimal bar -->
        <div class="nav-wrap">
            <nav class="nav" aria-label="Primary">
                <a class="logo" href="/">
                    <img src="/assets/holt-logo.webp" alt="" width="28" height="28" />
                    holt
                </a>
                <div class="nav-links">
                    <a href="/changelog">Changelog</a>
                    <a href="#why">Why Holt</a>
                </div>
                <div class="nav-actions">
                    <a class="nav-icon" href="https://github.com/Onion-L/holt" aria-label="GitHub">
                        <img src="/assets/github.svg" alt="" width="20" height="20" />
                    </a>
                    <a class="btn-nav" href="/download">Download <span class="icon icon-download" aria-hidden="true"></span></a>
                </div>
            </nav>
