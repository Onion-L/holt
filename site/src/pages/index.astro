---
import HeroController from "../components/HeroController";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Holt is an agent.</title>
        <meta
            name="description"
            content="Holt is a native desktop coding agent for macOS. Every step visible, every line yours to review."
        />
        <meta property="og:title" content="Holt is an agent." />
        <meta
            property="og:description"
            content="A native desktop coding agent for macOS."
        />
        <!-- Crawlers (X, Slack, …) ignore relative URLs; keep these absolute. -->
        <meta
            property="og:url"
            content="https://holt.onionl5236.workers.dev/"
        />
        <meta property="og:type" content="website" />
        <meta
            property="og:image"
            content="https://holt.onionl5236.workers.dev/assets/og.png"
        />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="Holt is an agent." />
        <meta
            name="twitter:description"
            content="A native desktop coding agent for macOS."
        />
        <meta
            name="twitter:image"
            content="https://holt.onionl5236.workers.dev/assets/og.png"
        />
        <meta name="theme-color" content="#f6f1e6" />
        <link rel="icon" type="image/png" href="/assets/favicon.png" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Anton&family=Geist:wght@400;700&family=Geist+Mono:wght@500&family=Instrument+Serif:ital@1&display=swap"
            rel="stylesheet"
        />
        <style is:inline>
            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }
            :root {
                --ink: #17233b;
                --cream: #f6f1e6;
                --paper: #fbf7ee;
                --blue: #0a4c9c;
                --deep: #072f66;
                --pink: #e34d83;
                --grey: #8a867c;
            }
            html,
            body {
                margin: 0;
                overflow-x: hidden;
            }
            body {
                background: var(--cream);
                font-family:
                    Geist,
                    -apple-system,
                    BlinkMacSystemFont,
                    sans-serif;
                -webkit-font-smoothing: antialiased;
            }
            a {
                color: inherit;
                text-decoration: none;
            }
            img {
                display: block;
            }
            .mono {
                font-family: "Geist Mono", Menlo, monospace;
            }

            /* ================= A — Billboard ================= */
            .va {
                position: relative;
                overflow: hidden;
                width: 100%;
                max-width: 100vw;
                min-height: 100vh;
                color: #fff;
                display: flex;
                flex-direction: column;
            }
            .va-bg {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: 50% 40%;
            }
            .va-scrim {
                position: absolute;
                inset: 0;
                background: linear-gradient(
                    180deg,
                    rgba(5, 25, 55, 0.35) 0%,
                    rgba(5, 25, 55, 0.05) 28%,
                    rgba(5, 25, 55, 0) 45%,
                    rgba(5, 20, 50, 0.58) 78%,
                    rgba(5, 20, 50, 0.78) 100%
                );
            }
            .va-top {
                position: relative;
                display: flex;
                justify-content: flex-end;
                align-items: center;
                padding: 26px clamp(20px, 4vw, 48px);
                z-index: 10;
            }
            .va-nav {
                display: flex;
                align-items: center;
                gap: 22px;
                font-size: 12px;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                background: rgba(5, 25, 55, 0.28);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border: 1px solid rgba(255, 255, 255, 0.18);
                padding: 8px 18px;
                border-radius: 999px;
            }
            .va-nav a {
                color: rgba(255, 255, 255, 0.88);
                transition: color 0.15s, border-color 0.15s;
                border-bottom: 1px solid transparent;
                padding-bottom: 1px;
            }
            .va-nav a:hover {
                color: #fff;
                border-color: rgba(255, 255, 255, 0.6);
            }
            .va-nav a:focus-visible {
                outline: 2px solid #fff;
                outline-offset: 3px;
                border-radius: 2px;
            }
            .va-hero {
                position: relative;
                margin-top: auto;
                padding: 0 clamp(20px, 4.5vw, 64px) clamp(40px, 7vh, 72px);
                z-index: 10;
            }
            .va-kicker {
                margin: 0;
                font-size: 12px;
                letter-spacing: 0.18em;
                text-transform: uppercase;
                color: rgba(255, 255, 255, 0.9);
                text-shadow: 0 1px 12px rgba(5, 25, 55, 0.6);
            }
            .va-title {
                margin: 12px 0 26px;
                font:
                    700 clamp(36px, 7.6vw, 104px)/0.98 Geist,
                    sans-serif;
                letter-spacing: -0.045em;
                text-shadow:
                    0 2px 18px rgba(5, 25, 55, 0.65),
                    0 8px 40px rgba(5, 25, 55, 0.45);
            }
            .va-cta {
                display: flex;
                gap: 14px;
                flex-wrap: wrap;
                align-items: center;
            }
            .va-btn {
                display: inline-flex;
                align-items: center;
                gap: 0.5em;
                padding: 13.5px 26px;
                border-radius: 999px;
                font-weight: 700;
                font-size: 14.5px;
                line-height: 1;
                cursor: pointer;
                user-select: none;
                transition:
                    transform 0.18s cubic-bezier(0.16, 1, 0.3, 1),
                    box-shadow 0.18s cubic-bezier(0.16, 1, 0.3, 1),
                    background-color 0.18s,
                    border-color 0.18s;
            }
            .va-btn:focus-visible {
                outline: 2px solid #fff;
                outline-offset: 3px;
            }
            .va-btn.solid {
                background: #fff;
                color: var(--deep);
                box-shadow:
                    0 2px 8px rgba(5, 25, 55, 0.2),
                    inset 0 1px 0 rgba(255, 255, 255, 0.9);
            }
            .va-btn.solid:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 28px -4px rgba(5, 25, 55, 0.42);
                background: #ffffff;
            }
            .va-btn.solid:active {
                transform: translateY(0);
                box-shadow: 0 4px 12px rgba(5, 25, 55, 0.25);
            }
            .va-btn.ghost {
                border: 1.5px solid rgba(255, 255, 255, 0.7);
                color: #fff;
                background: rgba(255, 255, 255, 0.08);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
            }
            .va-btn.ghost:hover {
                background: rgba(255, 255, 255, 0.2);
                border-color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 12px 28px -4px rgba(5, 25, 55, 0.35);
            }
            .va-btn.ghost:active {
                transform: translateY(0);
                box-shadow: 0 4px 12px rgba(5, 25, 55, 0.2);
            }
            .va-sub {
                margin: 20px 0 0;
                font-size: 12px;
                letter-spacing: 0.05em;
                color: rgba(255, 255, 255, 0.88);
                text-shadow: 0 1px 8px rgba(5, 25, 55, 0.45);
                word-break: break-word;
            }
            .va-sub a {
                color: #fff;
                text-decoration: underline;
                text-underline-offset: 3px;
                transition: color 0.15s;
            }
            .va-sub a:hover {
                color: var(--pink);
            }
            .va-sub a:focus-visible {
                outline: 2px solid var(--pink);
                outline-offset: 2px;
            }

            @media (max-width: 640px) {
                .va-top {
                    padding: 16px 16px;
                }
                .va-nav {
                    gap: 14px;
                    padding: 6px 14px;
                    font-size: 11px;
                }
                .va-hero {
                    padding: 0 18px 32px;
                }
                .va-kicker {
                    font-size: 11px;
                    letter-spacing: 0.15em;
                }
                .va-title {
                    margin: 8px 0 20px;
                    font-size: clamp(34px, 10vw, 44px);
                }
                .va-cta {
                    flex-direction: column;
                    align-items: stretch;
                    max-width: 290px;
                    gap: 10px;
                }
                .va-btn {
                    justify-content: center;
                    padding: 13px 20px;
                    font-size: 14px;
                }
                .va-bg {
                    object-position: 72% 35%;
                }
                .va-sub {
                    margin: 16px 0 0;
                    font-size: 11px;
                    line-height: 1.6;
                    max-width: 320px;
                }
            }

            @media (prefers-reduced-motion: reduce) {
                *,
                *::before,
                *::after {
                    transition-duration: 0s !important;
                    animation-duration: 0s !important;
                }
            }
        </style>
    </head>
    <body>
        <!-- ============ A — Billboard ============ -->
        <section class="va">
            <img
                class="va-bg"
                src="/assets/hero-coast.webp"
                alt="City Pop illustration of a girl with headphones overlooking a sunny coastal highway"
            />
            <div class="va-scrim"></div>
            <header class="va-top">
                <nav class="va-nav mono">
                    <a href="https://github.com/Onion-L/holt">GitHub ↗</a>
                    <a href="/changelog">Changelog ↗</a>
                </nav>
            </header>
            <div class="va-hero">
                <p class="va-kicker mono">Native coding agent · macOS</p>
                <h1 class="va-title">Holt is an agent.</h1>
                <div class="va-cta">
                    <a
                        class="va-btn solid"
                        data-arch="arm64"
                        href="https://github.com/Onion-L/holt/releases/latest"
                    >
                        ↓ Download for macOS
                    </a>
                    <a
                        class="va-btn ghost"
                        href="https://github.com/Onion-L/holt"
                    >
                        Star on GitHub ↗
                    </a>
                </div>
                <p class="va-sub mono">
                    Apple Silicon &amp; Intel · GPL-3.0 · v<span data-version>x.x.x</span> ·{" "}
                    <a href="/changelog">what's new ↗</a>
                </p>
            </div>
        </section>
        <HeroController client:load />
    </body>
</html>
