---
import DownloadController from '../components/DownloadController';
---

<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Holt — Download</title>
<meta name="description" content="Download Holt for macOS. Apple Silicon and Intel builds, signed and notarized. Windows and Linux are on the way." />
<meta property="og:title" content="Holt — Download" />
<meta property="og:description" content="The signed macOS build, ready to install. Windows and Linux are on the way." />
<meta property="og:url" content="https://holt.onionl5236.workers.dev/download" />
<meta property="og:type" content="website" />
<meta property="og:image" content="https://holt.onionl5236.workers.dev/assets/og.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="Holt — Download" />
<meta name="twitter:description" content="The signed macOS build, ready to install. Windows and Linux are on the way." />
<meta name="twitter:image" content="https://holt.onionl5236.workers.dev/assets/og.png" />
<meta name="theme-color" content="#f6f1e6" />
<link rel="icon" type="image/png" href="/assets/favicon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Geist:wght@400;700&family=Geist+Mono:wght@500&family=Instrument+Serif:ital@1&display=swap" rel="stylesheet" />
<style is:inline>
  *, *::before, *::after { box-sizing: border-box; }
  :root {
    --ink: #17233b; --cream: #f6f1e6; --paper: #fffdf8;
    --blue: #0a4c9c; --deep: #072f66; --pink: #e34d83; --grey: #8a867c; --line: rgba(23,35,59,.14);
  }
  html, body { margin: 0; }
  body {
    font-family: Geist, -apple-system, BlinkMacSystemFont, sans-serif;
    -webkit-font-smoothing: antialiased; color: var(--ink); background: var(--cream);
  }
  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 2px solid var(--pink); outline-offset: 3px; }
  .mono { font-family: "Geist Mono", Menlo, monospace; }

  .wrap { width: min(940px, 100% - 32px); margin: 0 auto; }

  /* ============ hero band — same artwork, scrim, and type as the landing ============ */
  .hero { position: relative; overflow: hidden; display: flex; flex-direction: column;
    min-height: clamp(320px, 44vh, 420px); color: #fff; }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 38%; }
  .hero-scrim { position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(5,25,55,.42) 0%, rgba(5,25,55,.12) 32%, rgba(5,20,50,.34) 62%, rgba(5,20,50,.76) 100%); }
  .hero-top { position: relative; z-index: 2; display: flex; justify-content: flex-end; align-items: center;
    padding: 26px 2px; width: min(940px, 100% - 32px); margin: 0 auto; }
  .nav {
    display: flex; align-items: center; gap: 22px; font-size: 12px; letter-spacing: .1em; text-transform: uppercase;
    background: rgba(5,25,55,.28); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,.18); padding: 8px 18px; border-radius: 999px;
  }
  .nav a { color: rgba(255,255,255,.88); border-bottom: 1px solid transparent; padding-bottom: 1px;
    transition: color .15s, border-color .15s; }
  .nav a:hover { color: #fff; border-color: rgba(255,255,255,.6); }
  .hero-inner { position: relative; z-index: 2; margin-top: auto; padding: 0 2px clamp(26px, 4.5vh, 44px); }
  .kicker { margin: 0; font-size: 12px; letter-spacing: .18em; text-transform: uppercase;
    color: rgba(255,255,255,.9); text-shadow: 0 1px 12px rgba(5,25,55,.6); }
  .kicker b { color: #fff; font-weight: 500; }
  .hero h1 { margin: 10px 0 0; font: 700 clamp(40px, 6.8vw, 84px)/0.96 Geist, sans-serif; letter-spacing: -.045em;
    text-shadow: 0 2px 18px rgba(5,25,55,.65), 0 8px 40px rgba(5,25,55,.45); }
  .hero h1 span { color: var(--pink); }

  /* ============ paper half ============ */
  main { padding-bottom: 90px; }
  .lede { margin: 28px 0 20px; max-width: 44ch; font-size: 14.5px; line-height: 1.6; color: #3c4658; }
  .lede em { font: italic 1.25em/1 "Instrument Serif", Georgia, serif; letter-spacing: 0; }

  .plats { border-bottom: 1px solid var(--line); }
  .plat {
    display: grid; grid-template-columns: 30px minmax(0, 1fr) auto;
    align-items: start; column-gap: 18px;
    padding: 24px 2px; border-top: 1px solid var(--line);
  }
  .plogo { display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; margin-top: 1px; color: var(--ink); }
  .plogo svg { width: 100%; height: 100%; fill: currentColor; display: block; }
  .pbody { padding-right: 24px; }
  .phead { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .pname { margin: 0; font: 700 19px/1 Geist, sans-serif; letter-spacing: -.02em; }
  .stamp { padding: 3px 10px; border: 1.5px solid var(--pink); border-radius: 999px;
    color: var(--pink); font-size: 9px; letter-spacing: .12em; text-transform: uppercase; white-space: nowrap; }
  .plat[data-soon] .stamp { border-color: rgba(23,35,59,.2); color: var(--grey); }
  .phere { display: none; font-size: 9px; letter-spacing: .12em; text-transform: uppercase; color: var(--blue); }
  .plat[data-yours] .phere { display: inline; }
  .pnote { margin: 7px 0 0; font-size: 12.5px; line-height: 1.55; color: #5b6472; }

  .dls { display: flex; gap: 16px; align-items: flex-start; justify-content: flex-end; align-self: center; }
  .dlc { display: flex; flex-direction: column; align-items: center; gap: 7px; }
  .dl {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 12px 24px; border-radius: 999px; border: 1.5px solid rgba(10,76,156,.35);
    color: var(--blue); font: 700 14px/1 Geist, sans-serif; letter-spacing: -.01em; white-space: nowrap;
    transition: transform .16s cubic-bezier(.16,1,.3,1), box-shadow .16s,
      background-color .15s, border-color .15s, color .15s;
  }
  a.dl:hover { transform: translateY(-2px); border-color: var(--blue); background: rgba(10,76,156,.06);
    box-shadow: 0 12px 24px -16px rgba(10,76,156,.9); }
  a.dl:active { transform: translateY(0); }
  .dl[data-pick] { background: var(--blue); border-color: var(--blue); color: #fff;
    box-shadow: 0 12px 26px -16px rgba(10,76,156,.95); }
  a.dl[data-pick]:hover { background: #0b56ad; border-color: #0b56ad; }
  .dl-meta { font-size: 10px; letter-spacing: .08em; color: var(--grey); white-space: nowrap; }

  .dsoon { align-self: center; font-size: 10.5px; letter-spacing: .08em; color: var(--grey); text-align: right; }

  /* ============ fine print ============ */
  .fine {
    margin: 0; padding: 22px 2px 0; border-top: 1px solid var(--line);
    display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 18px 40px;
  }
  .fine h3 { margin: 0 0 6px; font-size: 10.5px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--blue); }
  .fine p { margin: 0; font-size: 12px; line-height: 1.6; color: #5b6472; }
  .fine a { text-decoration: underline; text-underline-offset: 3px; }
  .fine a:hover { color: var(--blue); }

  .foot { text-align: center; margin-top: 56px; font-size: 11.5px; color: var(--grey); letter-spacing: .04em; }
  .foot a { text-decoration: underline; text-underline-offset: 3px; }
  .foot a:hover { color: var(--blue); }

  @media (max-width: 720px) {
    .hero { min-height: clamp(280px, 38vh, 340px); }
    .hero-bg { object-position: 68% 34%; }
    .hero-top { padding: 16px 2px; }
    .nav { gap: 14px; padding: 6px 14px; font-size: 11px; }
    .hero h1 { font-size: clamp(34px, 10vw, 44px); }
    .lede { margin: 22px 0 16px; font-size: 13.5px; }
    .plat { grid-template-columns: 26px minmax(0, 1fr); column-gap: 14px; padding: 20px 2px; }
    .plogo { width: 26px; height: 26px; }
    .dls, .dsoon { grid-column: 1 / -1; align-self: start; margin-top: 14px; }
    .dls { justify-content: stretch; gap: 12px; }
    .dlc { flex: 1 1 0; }
    .dl { width: 100%; }
    .dsoon { text-align: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition-duration: 0s !important; animation-duration: 0s !important; }
  }
</style>
</head>
<body>

<header class="hero">
  <img class="hero-bg" src="/assets/hero-coast.webp" alt="" />
  <div class="hero-scrim"></div>
  <div class="hero-top">
    <nav class="nav mono">
      <a href="/">← Home</a>
      <a href="/changelog">Changelog ↗</a>
      <a href="https://github.com/Onion-L/holt">GitHub ↗</a>
    </nav>
  </div>
  <div class="hero-inner wrap">
    <p class="kicker mono">Latest <b>v<span data-version>x.x.x</span></b> · Apple Silicon &amp; Intel</p>
    <h1>Download<span>.</span></h1>
  </div>
</header>

<main class="wrap">
  <p class="lede">
    Holt is a native coding agent for the desktop. The macOS build is signed and
    notarized; Windows and Linux are <em>on the way</em>.
  </p>

  <div class="plats">
    <article class="plat" data-platform="macos">
      <span class="plogo" aria-hidden="true">
        <svg viewBox="47.6 0 416.8 512"><path d="M451.1 174.6c-3 2.3-55.4 31.8-55.4 97.5 0 76 66.7 102.9 68.7 103.5-.3 1.6-10.6 36.8-35.2 72.7-21.9 31.5-44.8 63-79.6 63s-43.8-20.2-84-20.2c-39.2 0-53.1 20.9-84.9 20.9s-54.1-29.2-79.6-65c-29.6-42.1-53.5-107.5-53.5-169.5 0-99.5 64.7-152.3 128.4-152.3 33.8 0 62.1 22.2 83.3 22.2 20.2 0 51.8-23.6 90.3-23.6 14.6 0 67 1.3 101.5 50.8m-119.8-93c15.9-18.9 27.2-45.1 27.2-71.3 0-3.6-.3-7.3-1-10.3-25.9 1-56.7 17.3-75.3 38.8-14.6 16.6-28.2 42.8-28.2 69.4 0 4 .7 8 1 9.3 1.6.3 4.3.7 7 .7 23.2-.1 52.4-15.6 69.3-36.6"/></svg>
      </span>
      <div class="pbody">
        <div class="phead">
          <h2 class="pname">macOS</h2>
          <span class="stamp mono">available</span>
          <span class="phere mono">your system</span>
        </div>
        <p class="pnote">Signed and notarized. Pick the build that matches your chip — Apple menu → About This Mac says which.</p>
      </div>
      <div class="dls">
        <div class="dlc" data-download>
          <a class="dl" data-arch="arm64" data-asset="-arm64.dmg" data-pick
             href="https://github.com/Onion-L/holt/releases/latest">↓ Apple Silicon</a>
          <span class="dl-meta mono">arm64<span data-size></span></span>
        </div>
        <div class="dlc" data-download>
          <a class="dl" data-arch="x64" data-asset="-x64.dmg"
             href="https://github.com/Onion-L/holt/releases/latest">↓ Intel</a>
          <span class="dl-meta mono">x64<span data-size></span></span>
        </div>
      </div>
    </article>

    <!-- When a platform ships: drop data-soon, move its artifact label out of
         .dsoon into download links, and give each link the release asset
         name's tail as data-asset (e.g. "-x64-setup.exe"). -->
    <article class="plat" data-platform="windows" data-soon>
      <span class="plogo" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M0 0h11.377v11.372H0zm12.623 0H24v11.372H12.623zM0 12.623h11.377V24H0zm12.623 0H24V24H12.623"/></svg>
      </span>
      <div class="pbody">
        <div class="phead">
          <h2 class="pname">Windows</h2>
          <span class="stamp mono">coming soon</span>
          <span class="phere mono">your system</span>
        </div>
        <p class="pnote">The first Windows build will land here.</p>
      </div>
      <span class="dsoon mono">.exe · x64</span>
    </article>

    <article class="plat" data-platform="linux" data-soon>
      <span class="plogo" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a.424.424 0 00-.11.135c-.26.268-.45.6-.663.839-.199.199-.485.267-.797.4-.313.136-.658.269-.864.68-.09.189-.136.394-.132.602 0 .199.027.4.055.536.058.399.116.728.04.97-.249.68-.28 1.145-.106 1.484.174.334.535.47.94.601.81.2 1.91.135 2.774.6.926.466 1.866.67 2.616.47.526-.116.97-.464 1.208-.946.587-.003 1.23-.269 2.26-.334.699-.058 1.574.267 2.577.2.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071.771-.06 1.592-.536 2.257-1.306.631-.765 1.683-1.084 2.378-1.503.348-.199.629-.469.649-.853.023-.4-.2-.811-.714-1.376v-.097l-.003-.003c-.17-.2-.25-.535-.338-.926-.085-.401-.182-.786-.492-1.046h-.003c-.059-.054-.123-.067-.188-.135a.357.357 0 00-.19-.064c.431-1.278.264-2.55-.173-3.694-.533-1.41-1.465-2.638-2.175-3.483-.796-1.005-1.576-1.957-1.56-3.368.026-2.152.236-6.133-3.544-6.139zm.529 3.405h.013c.213 0 .396.062.584.198.19.135.33.332.438.533.105.259.158.459.166.724 0-.02.006-.04.006-.06v.105a.086.086 0 01-.004-.021l-.004-.024a1.807 1.807 0 01-.15.706.953.953 0 01-.213.335.71.71 0 00-.088-.042c-.104-.045-.198-.064-.284-.133a1.312 1.312 0 00-.22-.066c.05-.06.146-.133.183-.198.053-.128.082-.264.088-.402v-.02a1.21 1.21 0 00-.061-.4c-.045-.134-.101-.2-.183-.333-.084-.066-.167-.132-.267-.132h-.016c-.093 0-.176.03-.262.132a.8.8 0 00-.205.334 1.18 1.18 0 00-.09.4v.019c.002.089.008.179.02.267-.193-.067-.438-.135-.607-.202a1.635 1.635 0 01-.018-.2v-.02a1.772 1.772 0 01.15-.768c.082-.22.232-.406.43-.533a.985.985 0 01.594-.2zm-2.962.059h.036c.142 0 .27.048.399.135.146.129.264.288.344.465.09.199.14.4.153.667v.004c.007.134.006.2-.002.266v.08c-.03.007-.056.018-.083.024-.152.055-.274.135-.393.2.012-.09.013-.18.003-.267v-.015c-.012-.133-.04-.2-.082-.333a.613.613 0 00-.166-.267.248.248 0 00-.183-.064h-.021c-.071.006-.13.04-.186.132a.552.552 0 00-.12.27.944.944 0 00-.023.33v.01