012c-.015.262-.185.396-.498.595-.63.401-1.746.712-2.457 1.57-.618.737-1.37 1.14-2.036 1.191-.664.053-1.237-.2-1.574-.898l-.005-.003c-.21-.4-.12-1.025.056-1.69.176-.668.428-1.344.463-1.897.037-.714.076-1.335.195-1.814.12-.465.308-.797.641-.984l.045-.022zm-10.814.049h.01c.053 0 .105.005.157.014.376.055.706.333 1.023.752l.91 1.664.003.003c.243.533.754 1.064 1.189 1.637.434.598.77 1.131.729 1.57v.006c-.057.744-.48 1.148-1.125 1.294-.645.135-1.52.002-2.395-.464-.968-.536-2.118-.469-2.857-.602-.369-.066-.61-.2-.723-.4-.11-.2-.113-.602.123-1.23v-.004l.002-.003c.117-.334.03-.752-.027-1.118-.055-.401-.083-.71.043-.94.16-.334.396-.4.69-.533.294-.135.64-.202.915-.47h.002v-.002c.256-.268.445-.601.668-.838.19-.201.38-.336.663-.336zm7.159-9.074c-.435.201-.945.535-1.488.535-.542 0-.97-.267-1.28-.466-.154-.134-.28-.268-.373-.335-.164-.134-.144-.333-.074-.333.109.016.129.134.199.2.096.066.215.2.36.333.292.2.68.467 1.167.467.485 0 1.053-.267 1.398-.466.195-.135.445-.334.648-.467.156-.136.149-.267.279-.267.128.016.034.134-.147.332a8.097 8.097 0 01-.69.468zm-1.082-1.583V5.64c-.006-.02.013-.042.029-.05.074-.043.18-.027.26.004.063 0 .16.067.15.135-.006.049-.085.066-.135.066-.055 0-.092-.043-.141-.068-.052-.018-.146-.008-.163-.065zm-.551 0c-.02.058-.113.049-.166.066-.047.025-.086.068-.14.068-.05 0-.13-.02-.136-.068-.01-.066.088-.133.15-.133.08-.031.184-.047.259-.005.019.009.036.03.03.05v.02h.003z"/></svg>
      </span>
      <div class="pbody">
        <div class="phead">
          <h2 class="pname">Linux</h2>
          <span class="stamp mono">coming soon</span>
          <span class="phere mono">your system</span>
        </div>
        <p class="pnote">The first Linux build will land here.</p>
      </div>
      <span class="dsoon mono">.AppImage · x64</span>
    </article>
  </div>

  <div class="fine">
    <div>
      <h3 class="mono">First launch</h3>
      <p>Signed with a Developer ID and notarized by Apple. Open the DMG, drag Holt to Applications, then open it — no Gatekeeper workaround needed.</p>
    </div>
    <div>
      <h3 class="mono">Bring a model</h3>
      <p>Holt calls your provider, not ours. Add an API key under Settings → Providers on the first run, or point a custom provider at a local endpoint.</p>
    </div>
    <div>
      <h3 class="mono">Everything else</h3>
      <p>No accounts, no telemetry — chats and checkpoints stay under <span class="mono">~/.holt</span>. GPL-3.0, <a href="https://github.com/Onion-L/holt">source on GitHub ↗</a>.</p>
    </div>
  </div>

  <div class="foot mono">
    v<span data-version>x.x.x</span> ·
    <a href="https://github.com/Onion-L/holt/releases">all releases ↗</a> ·
    <a href="/changelog">changelog ↗</a> ·
    <a href="/">back to the coast ↖</a>
  </div>
</main>

<DownloadController client:load />
</body>
</html>
