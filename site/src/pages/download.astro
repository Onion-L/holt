        <div class="os-id">
          <span class="os-name"><span class="osname">Linux</span> <span class="yours mono">your system</span></span>
          <span class="note mono">AppImage · glibc 2.35+</span>
        </div>
      </div>
      <div class="os-actions">
        <span class="arches">
          <select class="arch" data-arch-select aria-label="Linux architecture">
          <option value="-x64.AppImage">x64</option>
          <option value="-arm64.AppImage">ARM64</option>
          </select>
        </span>
        <a class="dlbtn" data-download href="https://github.com/Onion-L/holt/releases/latest">Download</a>
      </div>
    </div>
  </section>

  <p class="fine">
    No accounts, no telemetry — chats and keys stay in
    <span class="mono">~/.holt</span> · GPL-3.0 ·
    <a href="https://github.com/Onion-L/holt">source <span class="icon icon-up-right" aria-hidden="true"></span></a>
