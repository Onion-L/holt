---
import DownloadController from '../components/DownloadController';
---

<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Holt — Download</title>
<meta name="description" content="Download Holt for macOS, Windows, and Linux. The macOS build is signed and notarized; Windows and Linux ship as native builds." />
<meta property="og:title" content="Holt — Download" />
<meta property="og:description" content="Signed macOS builds plus native Windows and Linux builds, ready to install." />
<meta property="og:url" content="https://holt.onionl5236.workers.dev/download" />
<meta property="og:type" content="website" />
<meta property="og:image" content="https://holt.onionl5236.workers.dev/assets/og.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="Holt — Download" />
<meta name="twitter:description" content="Signed macOS builds plus native Windows and Linux builds, ready to install." />
<meta name="twitter:image" content="https://holt.onionl5236.workers.dev/assets/og.png" />
<meta name="theme-color" content="#121316" />
<link rel="icon" type="image/png" href="/assets/favicon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://api.github.com" />
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
<style is:inline>
  *, *::before, *::after { box-sizing: border-box; }
  :root {
    --page: #121316; --surface: #1a1c20; --ink: #ece9e2;
    --muted: #979ba3; --coral: #ed9b7f; --dk: #0c0d0f; --line: rgba(255,255,255,.1);
  }
  html, body { margin: 0; }
  body {
    font-family: Archivo, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased; color: var(--ink);
    background: var(--page);
  }
  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 2px solid var(--coral); outline-offset: 3px; }
  .mono { font-family: "IBM Plex Mono", Menlo, monospace; }
  .icon { display: inline-block; flex-shrink: 0; width: 14px; height: 14px; background: currentColor; -webkit-mask: var(--icon) center/contain no-repeat; mask: var(--icon) center/contain no-repeat; }
  .icon-download { --icon: url("/assets/icons/download.svg"); }
  .icon-up-right { --icon: url("/assets/icons/arrow-up-right.svg"); }
  .icon-right { --icon: url("/assets/icons/arrow-right.svg"); }

  /* ── NAV — same bar as the changelog ── */
  .site-head { border-bottom: 1px solid var(--line); }
  .nav { display: flex; align-items: center; gap: clamp(28px,4vw,56px); padding: 24px clamp(20px,3vw,44px); }
  .brand { display: inline-flex; align-items: center; gap: 9px; font-size: 20px; font-weight: 900; letter-spacing: -.06em; }
  .brand img { width: 28px; height: 28px; border-radius: 6px; }
  .nav-links, .nav-actions { display: flex; align-items: center; gap: 28px; font-size: 14px; }
  .nav-links { color: var(--muted); }
  .nav-links a, .nav-actions a { transition: color .15s, opacity .15s; }
  .nav-links a:hover, .nav-links a[aria-current="page"], .download:hover { color: var(--ink); }
  .nav-actions { margin-left: auto; }
  .nav-icon { display: inline-flex; opacity: .6; }
  .nav-icon:hover { opacity: 1; }
  .nav-icon img { width: 20px; height: 20px; display: block; }
  .download { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; }

  /* ── PAGE HEAD — kicker + display title, changelog pattern ── */
  .page-head { width: min(1040px, 100% - 48px); margin: 0 auto; padding: 64px 0 56px; }
  .kicker { margin: 0 0 18px; color: var(--muted); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
  .kicker b { color: var(--coral); font-weight: 500; }
  .page-head h1 { margin: 0; font-size: clamp(52px,8vw,84px); line-height: .98; letter-spacing: -.055em; }
  .page-head h1 span { color: var(--coral); }
  .intro { max-width: 480px; margin: 24px 0 0; color: var(--muted); font-size: 15px; line-height: 1.7; }

  .wrap { width: min(1040px, 100% - 48px); margin: 0 auto; padding-bottom: 72px; }

  /* ── LEAD — icon and the version's coordinates, one quiet line ── */
  .lead { display: flex; align-items: center; gap: 18px; padding: 4px 0 26px; }
  .lead img { width: 60px; height: 60px; border-radius: 15px; flex-shrink: 0; }
  .lead-vnum { font-size: 26px; font-weight: 800; line-height: 1; letter-spacing: -.04em; }
  .lead-vdate { font-size: 10px; color: var(--muted); letter-spacing: .08em; text-transform: uppercase; }
  .lead-id { display: flex; flex-direction: column; gap: 7px; }
  .vlink { display: inline-flex; align-items: center; gap: 6px; margin-left: auto; font-size: 11.5px; color: var(--muted); transition: color .15s; }
  .vlink:hover { color: var(--coral); }

  /* ── OS ROWS — hairline rows in the changelog rhythm; the visitor's own
     row is the one primary action, the other two stay quiet ── */
  .os { display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: 20px;
    padding: 20px 0; border-top: 1px solid var(--line); }
  .os-rows { border-bottom: 1px solid var(--line); }
  .oshead { display: flex; align-items: center; gap: 13px; min-width: 0; }
  .osicon { display: flex; width: 18px; height: 18px; color: var(--ink); flex-shrink: 0; }
  .osicon svg { width: 100%; height: 100%; fill: currentColor; display: block; }
  .os-id { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .os-name { display: flex; align-items: center; gap: 10px; }
  .osname { font-size: 16px; font-weight: 700; letter-spacing: -.01em; }
  .yours { display: none; font-size: 9px; letter-spacing: .12em; text-transform: uppercase; color: var(--coral); }
  .os[data-yours] .yours { display: inline; }
  .note { margin: 0; font-size: 10px; letter-spacing: .06em; color: var(--muted); }

  .os-actions { display: flex; align-items: center; gap: 10px; }
  .arches { display: inline-flex; align-items: center; }
  .arches::after { content: ""; width: 9px; height: 9px; margin-left: -18px; background: currentColor; color: var(--muted); pointer-events: none;
    --icon: url("/assets/icons/chevron-down.svg"); -webkit-mask: var(--icon) center/contain no-repeat; mask: var(--icon) center/contain no-repeat; }
  .arch { appearance: none; -webkit-appearance: none; border: 1px solid var(--line); background: transparent; cursor: pointer;
    border-radius: 999px; padding: 6px 24px 6px 13px; color: var(--ink);
    font: 500 11px/1.3 "IBM Plex Mono", Menlo, monospace; transition: border-color .15s; }
  .arch:hover { border-color: rgba(255,255,255,.24); }
  .arch:disabled { color: var(--muted); cursor: default; opacity: .5; }

  .dlbtn { display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    height: 40px; padding: 0 22px; border-radius: 999px;
    background: var(--surface); border: 1px solid var(--line); color: var(--ink);
    font-size: 13px; font-weight: 600; letter-spacing: -.01em;
    transition: background-color .15s, color .15s, border-color .15s; }
  .dlbtn::before { content: ""; width: 13px; height: 13px; background: currentColor;
    --icon: url("/assets/icons/download.svg"); -webkit-mask: var(--icon) center/contain no-repeat; mask: var(--icon) center/contain no-repeat; }
  a.dlbtn:hover { background: #24272c; }
  /* The visitor's own row carries the one primary action on the page. */
  .os[data-yours] .dlbtn { background: var(--coral); border-color: transparent; color: var(--dk); font-weight: 700; }
  .os[data-yours] a.dlbtn:hover { background: #f0a58c; }
  /* A build this release does not carry: the row stays (the platform matrix
     is the page) but the action is not offered. */
  .os[data-unavailable] .dlbtn { background: transparent; color: var(--muted); pointer-events: none; }
  .os[data-unavailable] .arches::after { color: var(--line); }

  /* ── FINE PRINT + FOOT ── */
  .fine { margin: 0; padding: 22px 0 0; font-size: 11.5px; line-height: 1.7; color: var(--muted); }
  .fine .mono { color: var(--ink); }
  .fine a { display: inline-flex; align-items: center; gap: 4px; color: var(--ink); transition: color .15s; }
  .fine a:hover { color: var(--coral); }

  .foot { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-top: 44px; color: var(--muted); font-size: 10px; letter-spacing: .04em; }
  .foot a { display: inline-flex; align-items: center; gap: 6px; color: var(--ink); transition: color .15s; }
  .foot a:hover { color: var(--coral); }
  .fl { display: flex; gap: 22px; }

  @media (max-width: 720px) {
    .nav-links { display: none; }
    .page-head { padding: 48px 0 40px; }
    .vlink { margin-left: 0; }
    .os { grid-template-columns: minmax(0,1fr); gap: 14px; padding: 18px 0; }
    .os-actions { width: 100%; }
    .os-actions .arch { flex: 1; min-width: 0; }
    .os-actions .dlbtn { flex: 1; }
    .foot { flex-direction: column; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition-duration: 0s !important; animation-duration: 0s !important; }
  }
</style>
</head>
<body>

<header class="site-head">
  <nav class="nav" aria-label="Primary">
    <a class="brand" href="/">
      <img src="/assets/app-icon.webp" alt="" width="28" height="28" />
      holt
    </a>
    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/changelog">Changelog</a>
    </div>
    <div class="nav-actions">
      <a class="nav-icon" href="https://github.com/Onion-L/holt" aria-label="GitHub">
        <img src="/assets/github.svg" alt="" width="20" height="20" />
      </a>
      <a class="download" href="/download" aria-current="page">Download <span class="icon icon-download" aria-hidden="true"></span></a>
    </div>
  </nav>
  <div class="page-head">
    <p class="kicker mono">Latest release · <b>v<span data-version>x.x.x</span></b> · macOS · Windows · Linux</p>
    <h1>Download<span>.</span></h1>
    <p class="intro">One build per system, straight from the latest release. The macOS build is signed and notarized; Windows and Linux ship as native archives.</p>
  </div>
</header>

<main class="wrap">
  <section class="lead">
    <img src="/assets/app-icon.webp" alt="Holt" width="60" height="60" decoding="async" />
    <div class="lead-id">
      <span class="lead-vnum">v<span data-version>x.x.x</span></span>
      <span class="lead-vdate mono" data-date></span>
    </div>
    <a class="vlink mono" href="/changelog">View changelog <span class="icon icon-right" aria-hidden="true"></span></a>
  </section>

  <section class="os-rows">
    <div class="os" data-platform="macos">
      <div class="oshead">
        <span class="osicon" aria-hidden="true"><svg viewBox="47.6 0 416.8 512"><path d="M451.1 174.6c-3 2.3-55.4 31.8-55.4 97.5 0 76 66.7 102.9 68.7 103.5-.3 1.6-10.6 36.8-35.2 72.7-21.9 31.5-44.8 63-79.6 63s-43.8-20.2-84-20.2c-39.2 0-53.1 20.9-84.9 20.9s-54.1-29.2-79.6-65c-29.6-42.1-53.5-107.5-53.5-169.5 0-99.5 64.7-152.3 128.4-152.3 33.8 0 62.1 22.2 83.3 22.2 20.2 0 51.8-23.6 90.3-23.6 14.6 0 67 1.3 101.5 50.8m-119.8-93c15.9-18.9 27.2-45.1 27.2-71.3 0-3.6-.3-7.3-1-10.3-25.9 1-56.7 17.3-75.3 38.8-14.6 16.6-28.2 42.8-28.2 69.4 0 4 .7 8 1 9.3 1.6.3 4.3.7 7 .7 23.2-.1 52.4-15.6 69.3-36.6"/></svg></span>
        <div class="os-id">
          <span class="os-name"><span class="osname">macOS</span> <span class="yours mono">your system</span></span>
          <span class="note mono">Signed &amp; notarized</span>
        </div>
      </div>
      <div class="os-actions">
        <span class="arches">
          <select class="arch" data-arch-select aria-label="macOS architecture">
          <option value="-arm64.dmg">Apple Silicon</option>
          <option value="-x64.dmg">Intel</option>
          </select>
        </span>
        <a class="dlbtn" data-download href="https://github.com/Onion-L/holt/releases/latest">Download</a>
      </div>
    </div>

    <div class="os" data-platform="windows">
      <div class="oshead">
        <span class="osicon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M0 0h11.377v11.372H0zm12.623 0H24v11.372H12.623zM0 12.623h11.377V24H0zm12.623 0H24V24H12.623"/></svg></span>
        <div class="os-id">
          <span class="os-name"><span class="osname">Windows</span> <span class="yours mono">your system</span></span>
          <span class="note mono">installer (recommended) · zip · unsigned</span>
        </div>
      </div>
      <div class="os-actions">
        <span class="arches">
          <select class="arch" data-arch-select aria-label="Windows build">
          <option value="-x64-setup.exe">Installer · 64-bit</option>
          <option value="-arm64-setup.exe">Installer · ARM64</option>
          <option value="-x64-win.zip">Zip · 64-bit</option>
          <option value="-arm64-win.zip">Zip · ARM64</option>
          </select>
        </span>
        <a class="dlbtn" data-download href="https://github.com/Onion-L/holt/releases/latest">Download</a>
      </div>
    </div>

    <div class="os" data-platform="linux">
      <div class="oshead">
        <span class="osicon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a.424.424 0 00-.11.135c-.26.268-.45.6-.663.839-.199.199-.485.267-.797.4-.313.136-.658.269-.864.68-.09.189-.136.394-.132.602 0 .199.027.4.055.536.058.399.116.728.04.97-.249.68-.28 1.145-.106 1.484.174.334.535.47.94.601.81.2 1.91.135 2.774.6.926.466 1.866.67 2.616.47.526-.116.97-.464 1.208-.946.587-.003 1.23-.269 2.26-.334.699-.058 1.574.267 2.577.2.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071.771-.06 1.592-.536 2.257-1.306.631-.765 1.683-1.084 2.378-1.503.348-.199.629-.469.649-.853.023-.4-.2-.811-.714-1.376v-.097l-.003-.003c-.17-.2-.25-.535-.338-.926-.085-.401-.182-.786-.492-1.046h-.003c-.059-.054-.123-.067-.188-.135a.357.357 0 00-.19-.064c.431-1.278.264-2.55-.173-3.694-.533-1.41-1.465-2.638-2.175-3.483-.796-1.005-1.576-1.957-1.56-3.368.026-2.152.236-6.133-3.544-6.139zm.529 3.405h.013c.213 0 .396.062.584.198.19.135.33.332.438.533.105.259.158.459.166.724 0-.02.006-.04.006-.06v.105a.086.086 0 01-.004-.021l-.004-.024a1.807 1.807 0 01-.15.706.953.953 0 01-.213.335.71.71 0 00-.088-.042c-.104-.045-.198-.064-.284-.133a1.312 1.312 0 00-.22-.066c.05-.06.146-.133.183-.198.053-.128.082-.264.088-.402v-.02a1.21 1.21 0 00-.061-.4c-.045-.134-.101-.2-.183-.333-.084-.066-.167-.132-.267-.132h-.016c-.093 0-.176.03-.262.132a.8.8 0 00-.205.334 1.18 1.18 0 00-.09.4v.019c.002.089.008.179.02.267-.193-.067-.438-.135-.607-.202a1.635 1.635 0 01-.018-.2v-.02a1.772 1.772 0 01.15-.768c.082-.22.232-.406.43-.533a.985.985 0 01.594-.2zm-2.962.059h.036c.142 0 .27.048.399.135.146.129.264.288.344.465.09.199.14.4.153.667v.004c.007.134.006.2-.002.266v.08c-.03.007-.056.018-.083.024-.152.055-.274.135-.393.2.012-.09.013-.18.003-.267v-.015c-.012-.133-.04-.2-.082-.333a.613.613 0 00-.166-.267.248.248 0 00-.183-.064h-.021c-.071.006-.13.04-.186.132a.552.