    /* REAL HOLT MODEL PICKER POPOVER (Matched to Native Holt 1:1) */
    .desktop-model-popover { position: absolute; z-index: 50; bottom: 58px; right: 28px; width: 310px; background: #1a1b1e; border: 1px solid rgba(255,255,255,.12); border-radius: 12px; box-shadow: 0 20px 48px rgba(0,0,0,.75); overflow: hidden; backdrop-filter: blur(24px); display: flex; flex-direction: column; font-size: 13px; }
    .desktop-model-popover.is-hidden { display: none; }
    .model-picker-tabs { display: flex; align-items: center; height: 40px; padding: 0 8px; border-bottom: 1px solid rgba(255,255,255,.08); gap: 4px; }
    .model-picker-tab { position: relative; display: grid; place-items: center; width: 34px; height: 32px; border-radius: 6px; cursor: pointer; transition: background .12s; }
    .model-picker-tab:hover { background: rgba(255,255,255,.06); }
    .model-picker-tab-indicator { display: none; position: absolute; bottom: -4px; left: 4px; right: 4px; height: 2px; border-radius: 1px; background: #38bdf8; }
    .model-picker-tab.is-active .model-picker-tab-indicator { display: block; }
    .model-picker-search { display: flex; align-items: center; gap: 8px; height: 38px; padding: 0 12px; border-bottom: 1px solid rgba(255,255,255,.08); }
    .model-picker-search .desktop-icon { width: 14px; height: 14px; color: #7d7d85; }
    .model-picker-search input { flex: 1; background: transparent; border: none; outline: none; color: #e8e8ea; font-size: 13px; font-family: inherit; }
    .model-picker-search input::placeholder { color: #7d7d85; }
    .model-picker-list { max-height: 200px; overflow-y: auto; padding: 4px 6px; display: flex; flex-direction: column; gap: 2px; }
    .model-picker-row { display: flex; align-items: center; height: 32px; padding: 0 8px; border-radius: 6px; cursor: pointer; transition: background .12s; }
    .model-picker-row:hover { background: rgba(255,255,255,.06); }
    .model-picker-row.is-selected { background: rgba(255,255,255,.09); }
    .model-picker-name { font-size: 12.5px; font-weight: 600; color: #e8e8ea; }
    .model-picker-sub { font-size: 11px; color: #75757d; margin-left: 6px; }
    .model-picker-shortcut { margin-left: auto; font-family: "Holt Geist Mono", monospace; font-size: 10.5px; color: #7d7d85; background: rgba(255,255,255,.06); padding: 1px 5px; border-radius: 4px; }
    .model-picker-reasoning { border-top: 1px solid rgba(255,255,255,.08); padding: 6px 6px 8px; display: flex; flex-direction: column; gap: 2px; }
    .reasoning-heading { font-size: 10px; font-weight: 600; color: #7d7d85; letter-spacing: .08em; text-transform: uppercase; padding: 2px 8px 4px; }
    .reasoning-row { display: flex; align-items: center; justify-content: space-between; height: 28px; padding: 0 8px; border-radius: 6px; font-size: 12.5px; color: #d0d0d5; cursor: pointer; transition: background .12s, color .12s; }
    .reasoning-row:hover { background: rgba(255,255,255,.06); color: #fff; }
    .reasoning-row.is-selected { background: rgba(255,255,255,.09); color: #fff; font-weight: 500; }
    .reasoning-default-tag { font-size: 11px; color: #707077; }

    /* Popovers and Menus */
    .desktop-popover { position: absolute; z-index: 50; width: 240px; background: #161619; border: 1px solid rgba(255,255,255,.14); border-radius: 10px; box-shadow: 0 18px 40px rgba(0,0,0,.65); padding: 6px; backdrop-filter: blur(20px); font-size: 13px; }
    .desktop-popover.is-hidden { display: none; }
    .popover-header { padding: 6px 8px 4px; font-size: 10.5px; font-weight: 600; color: #7d7d85; text-transform: uppercase; letter-spacing: .06em; }
    .popover-list { display: flex; flex-direction: column; gap: 2px; }
    .popover-item, .popover-btn { display: flex; align-items: center; gap: 8px; width: 100%; padding: 6px 8px; border-radius: 6px; color: #d0d0d5; text-align: left; cursor: pointer; transition: background .12s, color .12s; }
    .popover-item:hover, .popover-btn:hover { background: rgba(255,255,255,.08); color: #fff; }
    .popover-item.is-selected { background: rgba(139,124,246,.12); color: #fff; }
