---
const prompt = "Review the landing page and make the product demo feel alive.";
// Ghost mark — holt_proto::motion MARK_GHOST_CELLS, on the 7×8 grid.
const ghostCells = [
    [2, 0], [3, 0], [4, 0],
    [1, 1], [2, 1], [3, 1], [4, 1], [5, 1],
    [0, 2], [1, 2], [2, 2], [3, 2], [4, 2], [5, 2], [6, 2],
    [0, 3], [1, 3], [3, 3], [5, 3], [6, 3],
    [0, 4], [1, 4], [2, 4], [3, 4], [4, 4], [5, 4], [6, 4],
    [0, 5], [1, 5], [2, 5], [3, 5], [4, 5], [5, 5], [6, 5],
    [0, 6], [1, 6], [2, 6], [3, 6], [4, 6], [5, 6], [6, 6],
    [0, 7], [2, 7], [4, 7], [6, 7],
];

const sessions = [
    {
        id: "demo",
        title: "Live product demo",
        time: "Now",
        branch: "main",
        provider: "zai",
        modelName: "GLM-5.3-Flash Max",
        reasoning: "",
        prompt: "Review the landing page and make the product demo feel alive.",
        tools: [
            { label: "Read", detail: "site/src/pages/index.astro", icon: "document" },
            { label: "Search", detail: "features and product demos", icon: "magnifer" },
            { label: "Edit", detail: "site/src/components/DesktopDemo.astro", icon: "pen" },
            { label: "Run", detail: "npm run build", icon: "command" },
        ],
        response: {
            intro: "Implemented the live product demo in <code>site/src/components/DesktopDemo.astro</code>.",
            bullets: [
                "Recreated Holt’s Desktop conversation and composer.",
                "Added typed input, visible tool activity, and a streamed reply.",
                "Preserved reduced-motion preferences and added replay.",
            ],
            result: "<code>npm run build</code> passes. All four pages build successfully.",
        },
    },
    {
        id: "checklist",
        title: "Refine the release checklist",
        time: "42m",
        branch: "main",
        provider: "anthropic",
        modelName: "Claude 3.7 Sonnet",
        reasoning: "High",
        prompt: "Update the release checklist to verify multi-platform binaries and Cloudflare build steps.",
        tools: [
            { label: "Read", detail: "docs/RELEASE.md", icon: "document" },
            { label: "Edit", detail: "docs/CHECKLIST.md", icon: "pen" },
        ],
        response: {
            intro: "Updated the release workflow checklist in <code>docs/CHECKLIST.md</code>:",
            bullets: [
                "Added SHA-256 binary validation on macOS, Windows, and Linux CI artifacts.",
                "Automated Cloudflare Worker build verification and changelog date checks.",
            ],
            result: "Release checklist is synchronized with root workspace version.",
        },
    },
    {
        id: "sidebar",
        title: "Fix sidebar resizing",
        time: "3h",
        branch: "main",
        provider: "openai",
        modelName: "GPT-4o",
        reasoning: "",
        prompt: "Fix jitter on the sidebar width tween during fast drag events.",
        tools: [
            { label: "Read", detail: "crates/ui/src/shell/panes.rs", icon: "document" },
            { label: "Edit", detail: "crates/ui/src/shell/panes.rs", icon: "pen" },
            { label: "Run", detail: "cargo test -p holt-ui", icon: "command" },
        ],
        response: {
            intro: "Fixed the sidebar width tween evaluation in <code>crates/ui/src/shell/panes.rs</code>:",
            bullets: [
                "Cached instantaneous mouse coordinates during drag gestures.",
                "Prevented re-evaluating the tween start timestamp during uninterrupted drag motions.",
            ],
            result: "<code>cargo test -p holt-ui</code> passed 42 tests without regressions.",
        },
    },
    {
        id: "settings",
        title: "Add provider settings",
        time: "Tue",
        branch: "main",
        provider: "deepseek",
        modelName: "DeepSeek-V3",
        reasoning: "",
        prompt: "Add configurable timeout and retry parameters to the provider settings panel.",
        tools: [
            { label: "Read", detail: "crates/ui/src/settings/providers.rs", icon: "document" },
            { label: "Edit", detail: "crates/ui/src/settings/providers.rs", icon: "pen" },
        ],
        response: {
            intro: "Added advanced provider connection settings:",
            bullets: [
                "Custom base URL input field with trailing slash normalization.",
                "Request timeout slider (5s - 120s) and streaming keepalive toggle.",
            ],
            result: "Provider settings persisted to <code>~/.holt/config.json</code>.",
        },
    },
];

const providers = [
    {
        id: "deepseek",
        name: "DeepSeek",
        icon: "/assets/providers/deepseek.svg",
        models: [
            { id: "deepseek-v3", name: "DeepSeek-V3", sub: "deepseek", shortcut: "⌘1" },
            { id: "deepseek-r1", name: "DeepSeek-R1", sub: "deepseek", shortcut: "⌘2" },
            { id: "deepseek-coder", name: "DeepSeek-Coder-V2", sub: "deepseek", shortcut: "⌘3" },
        ],
    },
    {
        id: "google",
        name: "Google",
        icon: "/assets/providers/gemini.svg",
        models: [
            { id: "gemini-2.5-pro", name: "Gemini 2.5 Pro", sub: "google", shortcut: "⌘1" },
            { id: "gemini-2.5-flash", name: "Gemini 2.5 Flash", sub: "google", shortcut: "⌘2" },
            { id: "gemini-2.0-flash", name: "Gemini 2.0 Flash", sub: "google", shortcut: "⌘3" },
        ],
    },
    {
        id: "kimi",
        name: "Kimi",
        icon: "/assets/providers/kimi.svg",
        models: [
            { id: "kimi-k3", name: "Kimi K3", sub: "kimi-coding", shortcut: "⌘1" },
            { id: "kimi-k3-256k", name: "Kimi K3-256K", sub: "kimi-coding", shortcut: "⌘2" },
            { id: "kimi-k3.1-pro", name: "Kimi K3.1 Pro", sub: "kimi-coding", shortcut: "⌘3" },
            { id: "kimi-k3.1-pro-highspeed", name: "Kimi K3.1 Pro Highspeed", sub: "kimi-coding", shortcut: "⌘4" },
            { id: "kimi-k2.7-code", name: "Kimi K2.7 Code", sub: "kimi-coding", shortcut: "⌘5" },
            { id: "kimi-for-coding-highspeed", name: "Kimi For Coding HighSpeed", sub: "kimi-coding", shortcut: "⌘6" },
        ],
    },
    {
        id: "minimax",
        name: "MiniMax",
        icon: "/assets/providers/minimax.svg",
        models: [
            { id: "minimax-text-01", name: "MiniMax-Text-01", sub: "minimax", shortcut: "⌘1" },
            { id: "abab6.5s-chat", name: "abab6.5s-chat", sub: "minimax", shortcut: "⌘2" },
        ],
    },
    {
        id: "xiaomi",
        name: "Xiaomi",
        icon: "/assets/providers/xiaomi.svg",
        models: [
            { id: "mimo-v1", name: "MiMo-V1", sub: "xiaomi", shortcut: "⌘1" },
        ],
    },
    {
        id: "zai",
        name: "Z.AI",
        icon: "/assets/providers/zai.svg",
        models: [
            { id: "glm-5.3-flash-max", name: "GLM-5.3-Flash Max", sub: "z-ai", shortcut: "⌘1" },
            { id: "glm-4-plus", name: "GLM-4-Plus", sub: "z-ai", shortcut: "⌘2" },
            { id: "glm-4-flash", name: "GLM-4-Flash", sub: "z-ai", shortcut: "⌘3" },
            { id: "glm-4-air", name: "GLM-4-Air", sub: "z-ai", shortcut: "⌘4" },
        ],
    },
];
---

<figure class="desktop-demo" data-desktop-demo data-phase="idle">
    <div class="desktop-viewport" data-desktop-viewport>
        <div class="desktop-app" data-desktop-app>
            <!-- Titlebar -->
            <div class="desktop-titlebar">
                <div class="desktop-traffic">
                    <i class="traffic-close"></i><i class="traffic-min"></i><i class="traffic-max"></i>
                </div>
                <div class="desktop-title-controls">
                    <button class="desktop-control desktop-sidebar-glyph" type="button" data-action="toggle-left-sidebar" title="Toggle Sidebar (Cmd+B)" aria-label="Toggle sidebar"></button>
                    <span class="desktop-control"><span class="desktop-icon desktop-i-arrow-left"></span></span>
                    <span class="desktop-control desktop-control-dim"><span class="desktop-icon desktop-i-arrow-right"></span></span>
                    <button class="desktop-control desktop-title-plus" type="button" data-title-plus data-action="new-chat" title="New Chat (Cmd+N)" aria-label="New chat"><span class="desktop-icon desktop-i-plus"></span></button>
                    <button class="desktop-control desktop-title-menu" type="button" data-menu-trigger="more" title="More options" aria-label="More options"><span class="desktop-icon desktop-i-menu-dots"></span></button>
                </div>
                <div class="desktop-session-title" data-session-title>
                    <img class="desktop-title-provider-icon" src="/assets/providers/kimi.svg" alt="" width="14" height="14" />
                    <span class="desktop-title-text">Live product demo</span>
                    <span class="desktop-session-target">holt</span>
                </div>
                <div class="desktop-title-actions" data-title-actions>
                    <button class="desktop-control" type="button" data-action="toggle-terminal" title="Toggle Terminal (Cmd+J)" aria-label="Toggle terminal"><span class="desktop-icon desktop-i-terminal"></span></button>
                    <button class="desktop-control" type="button" data-action="toggle-diff" title="Toggle Changes / Diff (Cmd+Shift+D)" aria-label="Toggle changes"><span class="desktop-icon desktop-i-split-columns"></span></button>
                </div>
            </div>

            <!-- Left Sidebar -->
            <aside class="desktop-sidebar" data-desktop-sidebar>
                <div class="sidebar-filter" data-menu-trigger="workspace" role="button" tabindex="0">
                    <span class="desktop-icon desktop-i-folder"></span>
                    <span class="sidebar-workspace-name">holt</span>
                    <span class="desktop-icon desktop-i-alt-arrow-down sidebar-filter-chevron"></span>
                    <span class="desktop-icon desktop-i-sort sidebar-sort"></span>
                </div>
                <div class="sidebar-sessions" data-sidebar-sessions>
                    <div class="sidebar-session sidebar-session-new is-active" data-new-session-row data-session-id="demo">
                        <div class="session-context"><span>holt</span><span>Now</span></div>
                        <div class="session-name">
                            <img class="session-provider-img" src="/assets/providers/kimi.svg" alt="" width="13" height="13" />
                            <span class="session-title-label">Live product demo</span>
                        </div>
                        <div class="session-meta"><span class="desktop-icon desktop-i-git-branch"></span><span>main</span></div>
                    </div>
                    {sessions.slice(1).map((s) => (
                        <div class="sidebar-session" data-session-id={s.id} role="button" tabindex="0">
                            <div class="session-context"><span>holt</span><span>{s.time}</span></div>
                            <div class="session-name">
                                <img src={`/assets/providers/${s.provider}.svg`} alt="" width="13" height="13" />
                                <span>{s.title}</span>
                            </div>
                            <div class="session-meta"><span class="desktop-icon desktop-i-git-branch"></span><span>{s.branch}</span></div>
                        </div>
                    ))}
                </div>
                <div class="sidebar-settings">
                    <span class="desktop-icon desktop-i-settings-minimalistic"></span>
                    <span>Settings</span>
                </div>
            </aside>

            <!-- Main Conversation / Canvas -->
            <main class="desktop-main" data-desktop-main>
                <div class="desktop-canvas" data-canvas>
                    <div class="desktop-canvas-inner">
                        <div class="desktop-mark">
                            {ghostCells.map(([x, y]) => (
                                <span style={`grid-column:${x + 1};grid-row:${y + 1};--cell-delay:-${(((6 - x + y) / 14) * 1.32).toFixed(3)}s`}></span>
                            ))}
                        </div>
                        <div class="desktop-canvas-title">What should we build today?</div>
                    </div>
                </div>

                <div class="desktop-transcript" data-transcript>
                    <div class="desktop-transcript-column" data-transcript-column>
                        <div class="desktop-user-row" data-user-row>
                            <div class="desktop-user-bubble" data-user-bubble>{prompt}</div>
                        </div>
                        <div class="desktop-user-meta-space"></div>

                        <div class="desktop-tool-group" data-tool-group>
                            <div class="desktop-tool-header" data-tool-toggle>
                                <span class="desktop-tool-disclosure" data-tool-disclosure>▾</span>
                                <span data-tool-summary>4 tool calls</span>
                            </div>
                            <div class="desktop-tool-list" data-tool-list>
                                {sessions[0].tools.map((tool) => (
                                    <div class="desktop-tool-row" data-tool-row>
                                        <span class={`desktop-icon desktop-i-${tool.icon} desktop-tool-icon`}></span>
                                        <span class="desktop-tool-label">{tool.label}</span>
                                        <span class="desktop-tool-detail">{tool.detail}</span>
                                        <span class="desktop-tool-state">
                                            <span class="desktop-tool-spinner">
                                                {Array.from({ length: 9 }, (_, index) => <i style={`--matrix-index:${index}`}></i>)}
                                            </span>
                                            <span class="desktop-icon desktop-i-check desktop-tool-check"></span>
                                        </span>
                                    </div>
                                ))}
                            </div>
                        </div>

                        <div class="desktop-assistant-response" data-assistant-response>
                            <p class="desktop-response-block" data-response-chunk>Implemented the live product demo in <code>site/src/components/DesktopDemo.astro</code>.</p>
                            <ul>
                                <li class="desktop-response-block" data-response-chunk>Recreated Holt’s Desktop conversation and composer.</li>
                                <li class="desktop-response-block" data-response-chunk>Added typed input, visible tool activity, and a streamed reply.</li>
                                <li class="desktop-response-block" data-response-chunk>Preserved reduced-motion preferences and added replay.</li>
                            </ul>
                            <p class="desktop-response-block desktop-response-result" data-response-chunk><code>npm run build</code> passes. All four pages build successfully.</p>
                        </div>

                        <div class="desktop-working" data-working>
                            <span class="desktop-working-dots"><i></i><i></i><i></i></span>
                            <span data-working-label>Thinking…</span>
                            <span class="desktop-working-elapsed" data-working-elapsed>0s</span>
                        </div>
                    </div>
                </div>

                <div class="desktop-composer-stack">
                    <div class="desktop-status" data-status>
                        <span class="desktop-status-spinner"></span><span data-status-text>Sending…</span>
                    </div>
                    <div class="desktop-composer-column">
                        <div class="desktop-project-selector" data-project-selector data-menu-trigger="workspace">
                            <span class="desktop-icon desktop-i-folder"></span><span class="project-name-label">holt</span><span class="desktop-icon desktop-i-alt-arrow-down desktop-chip-chevron"></span>
                        </div>
                        <div class="desktop-composer" data-composer>
                            <div class="desktop-composer-input" data-composer-input-wrap>
                                <textarea
                                    class="desktop-composer-textarea"
                                    data-composer-textarea
                                    placeholder="Do anything…"
                                    rows="1"
                                    aria-label="Composer input"
                                ></textarea>
                            </div>
                            <div class="desktop-composer-actions">
                                <div class="desktop-model-chip" data-menu-trigger="model" role="button" tabindex="0" title="Select Model">
                                    <img class="desktop-model-icon" src="/assets/providers/kimi.svg" alt="" width="14" height="14" />
                                    <span class="desktop-model-label">Kimi K3.1 Pro</span>
                                    <span class="desktop-reasoning-chip" data-reasoning-chip>Max</span>
                                    <span class="desktop-icon desktop-i-alt-arrow-down desktop-chip-chevron"></span>
                                </div>
                                <span class="desktop-attach"><span class="desktop-icon desktop-i-paperclip"></span></span>
                                <button class="desktop-send" type="button" data-send-button aria-label="Send prompt">
                                    <span class="desktop-icon desktop-i-arrow-up desktop-send-arrow"></span>
                                    <span class="desktop-send-stop"></span>
                                </button>
                            </div>
                        </div>
                        <div class="desktop-composer-footer">
                            <div class="desktop-footer-left">
                                <span class="desktop-footer-chip desktop-permission" data-menu-trigger="permission" role="button" tabindex="0"><span class="desktop-icon desktop-i-lock-open"></span><span class="permission-label">Full access</span><span class="desktop-icon desktop-i-alt-arrow-down desktop-chip-chevron"></span></span>
                                <span class="desktop-footer-chip" data-menu-trigger="workspace" role="button" tabindex="0"><span class="desktop-icon desktop-i-folder"></span><span>Current checkout</span><span class="desktop-icon desktop-i-alt-arrow-down desktop-chip-chevron"></span></span>
                            </div>
                            <span class="desktop-footer-chip" data-menu-trigger="branch" role="button" tabindex="0"><span class="desktop-icon desktop-i-git-branch"></span><span class="branch-label">main</span><span class="desktop-icon desktop-i-alt-arrow-down desktop-chip-chevron"></span></span>
                        </div>
                    </div>
                </div>
            </main>

            <!-- Right Pane: Diff, Terminal, Files -->
            <aside class="desktop-right-pane is-closed" data-right-pane>
                <div class="right-pane-header">
                    <div class="right-pane-tabs">
                        <button class="right-pane-tab is-active" type="button" data-pane-tab="diff">
                            <span class="desktop-icon desktop-i-pen"></span><span>Diff</span>
                            <span class="right-pane-badge">1</span>
                        </button>
                        <button class="right-pane-tab" type="button" data-pane-tab="terminal">
                            <span class="desktop-icon desktop-i-terminal"></span><span>Terminal</span>
                        </button>
                        <button class="right-pane-tab" type="button" data-pane-tab="files">
                            <span class="desktop-icon desktop-i-folder"></span><span>Files</span>
                        </button>
                    </div>
                    <button class="right-pane-close" type="button" data-action="close-right-pane" title="Close Pane" aria-label="Close pane">
                        <span class="desktop-icon desktop-i-close"></span>
                    </button>
                </div>
                <div class="right-pane-body">
                    <!-- Diff Surface -->
                    <div class="right-pane-view is-active" data-pane-view="diff">
                        <div class="diff-file-header">
                            <span class="diff-file-name">site/src/components/DesktopDemo.astro</span>
                            <span class="diff-file-stats"><i class="diff-stat-add">+28</i><i class="diff-stat-del">-6</i></span>
                        </div>
                        <div class="diff-content">
                            <div class="diff-hunk">@@ -24,8 +24,14 @@ &lt;figure class="desktop-demo"&gt;</div>
                            <div class="diff-line diff-del"><span class="diff-num">24</span><span class="diff-sig">-</span><span>const activeSession = "demo";</span></div>
                            <div class="diff-line diff-del"><span class="diff-num">25</span><span class="diff-sig">-</span><span>// Static preview only</span></div>
                            <div class="diff-line diff-add"><span class="diff-num">24</span><span class="diff-sig">+</span><span>// Real Holt desktop interactive runtime:</span></div>
                            <div class="diff-line diff-add"><span class="diff-num">25</span><span class="diff-sig">+</span><span>const [active, setActive] = useState(session);</span></div>
                            <div class="diff-line diff-add"><span class="diff-num">26</span><span class="diff-sig">+</span><span>sidebar.toggle(&#123; animated: true &#125;);</span></div>
                            <div class="diff-line diff-add"><span class="diff-num">27</span><span class="diff-sig">+</span><span>rightPane.open("diff");</span></div>
                            <div class="diff-line diff-add"><span class="diff-num">28</span><span class="diff-sig">+</span><span>composer.listen("send", executeTurn);</span></div>
                            <div class="diff-line"><span class="diff-num">29</span><span class="diff-sig"> </span><span>await engine.dispatch(turn);</span></div>
                            <div class="diff-line"><span class="diff-num">30</span><span class="diff-sig"> </span><span>transcript.append(response);</span></div>
                        </div>
                    </div>

                    <!-- Terminal Surface -->
                    <div class="right-pane-view" data-pane-view="terminal">
                        <div class="terminal-header-bar">
                            <span>zsh · node v22.12.0 · holt-engine</span>
                        </div>
                        <div class="terminal-body">
                            <div class="term-line"><span class="term-prompt">onion@mac holt %</span> <span class="term-cmd">npm run build</span></div>
                            <div class="term-line term-dim">> site@0.0.1 build</div>
                            <div class="term-line term-dim">> astro build</div>
                            <div class="term-line"><span class="term-accent">[vite]</span> ✓ built in 42ms</div>
                            <div class="term-line"><span class="term-accent">[build]</span> ✓ 4 page(s) built in 222ms</div>
                            <div class="term-line term-success"><span class="term-accent">[build]</span> Complete!</div>
                            <div class="term-line"><span class="term-prompt">onion@mac holt %</span> <span class="term-cmd">cargo test --workspace</span></div>
                            <div class="term-line term-success">test result: ok. 184 passed; 0 failed; finished in 2.14s</div>
                            <div class="term-line"><span class="term-prompt">onion@mac holt %</span> <span class="term-cursor">█</span></div>
                        </div>
                    </div>

                    <!-- Files Surface -->
                    <div class="right-pane-view" data-pane-view="files">
                        <div class="file-tree">
                            <div class="file-item file-dir"><span class="desktop-icon desktop-i-folder"></span><span>site</span></div>
                            <div class="file-item file-dir file-indent"><span class="desktop-icon desktop-i-folder"></span><span>src</span></div>
                            <div class="file-item file-dir file-indent-2"><span class="desktop-icon desktop-i-folder"></span><span>components</span></div>
                            <div class="file-item file-doc file-indent-3 is-modified"><span class="desktop-icon desktop-i-document"></span><span>DesktopDemo.astro</span><span class="file-badge-m">M</span></div>
                            <div class="file-item file-doc file-indent-3"><span class="desktop-icon desktop-i-document"></span><span>HeroController.tsx</span></div>
                            <div class="file-item file-dir file-indent-2"><span class="desktop-icon desktop-i-folder"></span><span>pages</span></div>
                            <div class="file-item file-doc file-indent-3"><span class="desktop-icon desktop-i-document"></span><span>index.astro</span></div>
                            <div class="file-item file-dir"><span class="desktop-icon desktop-i-folder"></span><span>crates</span></div>
                            <div class="file-item file-dir file-indent"><span class="desktop-icon desktop-i-folder"></span><span>ui</span></div>
                            <div class="file-item file-dir file-indent"><span class="desktop-icon desktop-i-folder"></span><span>core</span></div>
                            <div class="file-item file-dir file-indent"><span class="desktop-icon desktop-i-folder"></span><span>engine</span></div>
                            <div class="file-item file-doc"><span class="desktop-icon desktop-i-document"></span><span>Cargo.toml</span></div>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Real Holt Model Picker Popover (Matches Holt Native GPUI app 1:1) -->
            <div class="desktop-model-popover is-hidden" data-popover="model">
                <!-- Provider Tabs across top -->
                <div class="model-picker-tabs">
                    {providers.map((p, idx) => (
                        <div class={`model-picker-tab ${idx === 2 ? "is-active" : ""}`} data-provider-tab={p.id} title={p.name}>
                            <img src={p.icon} alt={p.name} width="18" height="18" />
                            <span class="model-picker-tab-indicator"></span>
                        </div>
                    ))}
                </div>
                <!-- Search input -->
                <div class="model-picker-search">
                    <span class="desktop-icon desktop-i-magnifer"></span>
                    <input type="text" placeholder="Search models…" data-model-search aria-label="Search models" />
                </div>
                <!-- Model Rows -->
                <div class="model-picker-list" data-model-list>
                    {/* Populated dynamically */}
                </div>
                <!-- Reasoning Section -->
                <div class="model-picker-reasoning">
                    <div class="reasoning-heading">REASONING</div>
                    <div class="reasoning-row" data-reasoning="Low"><span>Low</span></div>
                    <div class="reasoning-row" data-reasoning="High"><span>High</span><span class="reasoning-default-tag">Default</span></div>
                    <div class="reasoning-row is-selected" data-reasoning="Max"><span>Max</span></div>
                </div>
            </div>

            <!-- Workspace Menu -->
            <div class="desktop-popover desktop-workspace-popover is-hidden" data-popover="workspace">
