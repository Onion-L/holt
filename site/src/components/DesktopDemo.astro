    .popover-divider { height: 1px; margin: 4px 6px; background: rgba(255,255,255,.07); }
    .desktop-more-popover { left: 160px; top: 40px; width: 220px; }
    .desktop-workspace-popover { left: 14px; top: 72px; width: 240px; }
    .desktop-permission-popover { left: 24px; bottom: 48px; width: 260px; }
    .desktop-branch-popover { right: 24px; bottom: 48px; width: 210px; }

    /* Clean slim scrollbars */
    .model-picker-list::-webkit-scrollbar,
    .sidebar-sessions::-webkit-scrollbar,
    .desktop-transcript::-webkit-scrollbar,
    .right-pane-body::-webkit-scrollbar {
        width: 4px;
    }
    .model-picker-list::-webkit-scrollbar-track,
    .sidebar-sessions::-webkit-scrollbar-track,
    .desktop-transcript::-webkit-scrollbar-track,
    .right-pane-body::-webkit-scrollbar-track {
        background: transparent;
    }
    .model-picker-list::-webkit-scrollbar-thumb,
    .sidebar-sessions::-webkit-scrollbar-thumb,
    .desktop-transcript::-webkit-scrollbar-thumb,
    .right-pane-body::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.14);
        border-radius: 2px;
    }
    .model-picker-empty {
        padding: 20px 8px;
        text-align: center;
        color: #7d7d85;
        font-size: 12px;
    }

    .desktop-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

    @media (max-width: 520px) {
        .desktop-demo { margin-bottom: 64px; }
        .desktop-viewport { border-radius: 8px; }
    }
    @media (prefers-reduced-motion: reduce) {
        .desktop-demo *, .desktop-demo *::before, .desktop-demo *::after { animation: none !important; transition: none !important; }
        .desktop-mark span { opacity: .9; transform: none; }
    }
</style>

<script is:inline define:vars={{ initialSessions: sessions, initialProviders: providers }}>
    (() => {
        const root = document.querySelector("[data-desktop-demo]");
        if (!root) return;

        const one = (sel, parent = root) => parent.querySelector(sel);
        const all = (sel, parent = root) => [...parent.querySelectorAll(sel)];

        const viewport = one("[data-desktop-viewport]");
        const app = one("[data-desktop-app]");
        const sidebar = one("[data-desktop-sidebar]");
        const main = one("[data-desktop-main]");
        const rightPane = one("[data-right-pane]");
        const canvas = one("[data-canvas]");
        const transcript = one("[data-transcript]");
        const userRow = one("[data-user-row]");
        const userBubble = one("[data-user-bubble]");
        const newSessionRow = one("[data-new-session-row]");
        const sessionTitle = one("[data-session-title]");
        const titlePlus = one("[data-title-plus]");
        const titleActions = one("[data-title-actions]");
        const toolGroup = one("[data-tool-group]");
        const toolDisclosure = one("[data-tool-disclosure]");
        const toolSummary = one("[data-tool-summary]");
        const toolRows = all("[data-tool-row]");
        const responseChunks = all("[data-response-chunk]");
        const working = one("[data-working]");
        const workingLabel = one("[data-working-label]");
        const workingElapsed = one("[data-working-elapsed]");
        const statusEl = one("[data-status]");
        const statusText = one("[data-status-text]");
        const projectSelector = one("[data-project-selector]");
        const composer = one("[data-composer]");
        const textarea = one("[data-composer-textarea]");
        const sendBtn = one("[data-send-button]");
        // Popovers
        const popovers = {
            model: one('[data-popover="model"]'),
            more: one('[data-popover="more"]'),
            workspace: one('[data-popover="workspace"]'),
            permission: one('[data-popover="permission"]'),
            branch: one('[data-popover="branch"]'),
        };

        const modelListEl = one("[data-model-list]");
        const modelSearchInput = one("[data-model-search]");

        const promptText = "Review the landing page and make the product demo feel alive.";
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

        // State
        const sessionsMap = new Map();
        initialSessions.forEach(s => sessionsMap.set(s.id, { ...s }));

        let activeSessionId = "demo";
        let isLeftSidebarOpen = true;
        let isRightPaneOpen = false;
        let activeRightTab = "diff";
        let activeProviderId = "kimi";
        let activeModelId = "kimi-k3.1-pro";
        let activeModelName = "Kimi K3.1 Pro";
        let activeReasoning = "Max";
        let activeWorkspace = "holt";
        let activePermission = "Full access";
        let activeBranch = "main";

        let runId = 0;
        let running = false;
        let completed = false;
        let userInteracted = false;
        let elapsedTimer = null;

        const fit = () => {
            if (!viewport || !app) return;
            app.style.transform = `scale(${viewport.clientWidth / 1180})`;
        };
        new ResizeObserver(fit).observe(viewport);
        fit();

        const wait = (ms, id) => new Promise((resolve, reject) => {
            window.setTimeout(() => {
                if (id === runId) resolve();
                else reject(new DOMException("Animation replaced", "AbortError"));
            }, ms);
        });

        const stopElapsed = () => {
            if (elapsedTimer !== null) window.clearInterval(elapsedTimer);
            elapsedTimer = null;
        };

        const startElapsed = () => {
            stopElapsed();
            const startedAt = Date.now();
            workingElapsed.textContent = "0s";
            elapsedTimer = window.setInterval(() => {
                workingElapsed.textContent = `${Math.floor((Date.now() - startedAt) / 1000)}s`;
            }, 500);
        };

        const closeAllPopovers = () => {
            Object.values(popovers).forEach(p => p && p.classList.add("is-hidden"));
        };

        const togglePopover = (name) => {
            const target = popovers[name];
            if (!target) return;
            const willOpen = target.classList.contains("is-hidden");
            closeAllPopovers();
            if (willOpen) target.classList.remove("is-hidden");
        };

        // Render Model Picker models for active provider
        const renderModelList = (query = "") => {
            const provider = initialProviders.find(p => p.id === activeProviderId);
            if (!provider || !modelListEl) return;

            const q = query.trim().toLowerCase();
            const filtered = q
                ? provider.models.filter(m => m.name.toLowerCase().includes(q) || m.sub.toLowerCase().includes(q))
                : provider.models;

            if (filtered.length === 0) {
                modelListEl.innerHTML = `<div class="model-picker-empty">No models found</div>`;
                return;
            }

            modelListEl.innerHTML = filtered.map(m => `
                <div class="model-picker-row ${m.id === activeModelId ? "is-selected" : ""}" data-model-id="${m.id}" data-model-name="${m.name}">
                    <span class="model-picker-name">${m.name}</span>
                    <span class="model-picker-sub">${m.sub}</span>
                    <span class="model-picker-shortcut">${m.shortcut}</span>
                </div>
            `).join("");
        };

        // Update the composer model chip
        const updateModelChip = () => {
            const provider = initialProviders.find(p => p.id === activeProviderId);
            const chipIcon = one(".desktop-model-icon");
            const chipLabel = one(".desktop-model-label");
            const reasoningChip = one("[data-reasoning-chip]");
            if (provider && chipIcon) chipIcon.src = provider.icon;
            if (chipLabel) chipLabel.textContent = activeModelName;
            if (reasoningChip) {
                if (activeReasoning) {
                    reasoningChip.textContent = activeReasoning;
                    reasoningChip.style.display = "inline-block";
                } else {
                    reasoningChip.style.display = "none";
                }
            }
        };

        // Reset demo to initial state
        const reset = () => {
            runId += 1;
            stopElapsed();
            root.dataset.phase = "idle";
            canvas.classList.remove("is-hidden");
            transcript.classList.remove("is-visible");
            userRow.classList.remove("is-visible");
            userBubble.classList.remove("is-confirmed");
            userBubble.textContent = promptText;
            newSessionRow.classList.remove("is-visible");
            sessionTitle.classList.remove("is-visible");
            titlePlus.classList.remove("is-visible");
            titleActions.classList.remove("is-visible");
            toolGroup.classList.remove("is-open", "is-collapsed");
            toolDisclosure.textContent = "▾";
            toolDisclosure.classList.remove("is-collapsed");
            toolSummary.textContent = "4 tool calls";
            toolRows.forEach((row) => row.classList.remove("is-visible", "is-pending", "is-done"));
            responseChunks.forEach((chunk) => chunk.classList.remove("is-visible"));
            working.classList.remove("is-visible");
            workingLabel.textContent = "Thinking…";
            statusEl.classList.remove("is-visible");
            projectSelector.classList.remove("is-hidden");
            composer.classList.remove("is-compact");
            textarea.value = "";
            sendBtn.classList.remove("is-running");
        };

        const showConversation = () => {
            canvas.classList.add("is-hidden");
            transcript.classList.add("is-visible");
            userRow.classList.add("is-visible");
            newSessionRow.classList.add("is-visible");
            sessionTitle.classList.add("is-visible");
            titlePlus.classList.add("is-visible");
            titleActions.classList.add("is-visible");
            projectSelector.classList.add("is-hidden");
            composer.classList.add("is-compact");
            textarea.value = "";
        };

        const showFinal = () => {
            reset();
            showConversation();
            userBubble.classList.add("is-confirmed");
            toolGroup.classList.add("is-collapsed");
            toolDisclosure.textContent = "▸";
            toolRows.forEach((row) => row.classList.add("is-visible", "is-done"));
            responseChunks.forEach((chunk) => chunk.classList.add("is-visible"));
            root.dataset.phase = "done";
        };

        // Auto animated demo run
        const run = async () => {
            reset();
            const id = runId;
            root.dataset.phase = "typing";
            await wait(450, id);

            for (let index = 0; index < promptText.length; index += 1) {
                textarea.value = promptText.slice(0, index + 1);
                await wait(promptText[index] === " " ? 18 : 28, id);
            }

            await wait(350, id);
            root.dataset.phase = "sent";
            showConversation();
            sendBtn.classList.add("is-running");
            statusEl.classList.add("is-visible");
            await wait(500, id);

            statusEl.classList.remove("is-visible");
            userBubble.classList.add("is-confirmed");
            working.classList.add("is-visible");
            startElapsed();
            root.dataset.phase = "working";
            await wait(700, id);

            root.dataset.phase = "tools";
            toolGroup.classList.add("is-open");
            workingLabel.textContent = "Working…";
            for (const row of toolRows) {
                row.classList.add("is-visible", "is-pending");
                await wait(700, id);
                row.classList.remove("is-pending");
                row.classList.add("is-done");
            }

            await wait(400, id);
            root.dataset.phase = "answering";
            toolGroup.classList.remove("is-open");
            toolGroup.classList.add("is-collapsed");
            toolDisclosure.textContent = "▸";

            for (const chunk of responseChunks) {
                chunk.classList.add("is-visible");
                await wait(380, id);
            }

            working.classList.remove("is-visible");
            stopElapsed();
            sendBtn.classList.remove("is-running");
            root.dataset.phase = "done";
            completed = true;
            running = false;
        };

        const start = () => {
            if (running || completed || userInteracted) return;
            running = true;
            if (reducedMotion.matches) {
                showFinal();
                completed = true;
                running = false;
                return;
            }
            run().catch((error) => {
                if (error.name !== "AbortError") throw error;
            });
        };

        const stop = () => {
            running = false;
            runId += 1;
            stopElapsed();
        };

        // Switch to selected session
        const switchSession = (sessionId) => {
            userInteracted = true;
            stop();
            activeSessionId = sessionId;
            all("[data-session-id]").forEach(el => {
                el.classList.toggle("is-active", el.dataset.sessionId === sessionId);
            });

            if (sessionId === "new") {
                // Blank canvas state
                canvas.classList.remove("is-hidden");
                transcript.classList.remove("is-visible");
                projectSelector.classList.remove("is-hidden");
                composer.classList.remove("is-compact");
                one(".desktop-title-text").textContent = "New Session";
                one(".desktop-title-provider-icon").src = `/assets/providers/${activeProviderId}.svg`;
                textarea.value = "";
                textarea.focus();
                return;
            }

            const session = sessionsMap.get(sessionId);
            if (!session) return;

            showConversation();
            userBubble.classList.add("is-confirmed");
            userBubble.textContent = session.prompt;
            one(".desktop-title-text").textContent = session.title;
            one(".desktop-title-provider-icon").src = `/assets/providers/${session.provider}.svg`;

            // Tool group
            if (session.tools && session.tools.length) {
                toolGroup.style.display = "block";
                toolGroup.classList.remove("is-open");
                toolGroup.classList.add("is-collapsed");
                toolDisclosure.textContent = "▸";
                toolSummary.textContent = `${session.tools.length} tool calls`;
                one("[data-tool-list]").innerHTML = session.tools.map(t => `
                    <div class="desktop-tool-row is-visible is-done">
                        <span class="desktop-icon desktop-i-${t.icon} desktop-tool-icon"></span>
                        <span class="desktop-tool-label">${t.label}</span>
                        <span class="desktop-tool-detail">${t.detail}</span>
                        <span class="desktop-tool-state"><span class="desktop-icon desktop-i-check desktop-tool-check" style="display:block"></span></span>
                    </div>
                `).join("");
            } else {
                toolGroup.style.display = "none";
            }

            // Response
            if (session.response) {
                one("[data-assistant-response]").innerHTML = `
                    <p class="desktop-response-block is-visible">${session.response.intro || ""}</p>
                    ${session.response.bullets ? `<ul>${session.response.bullets.map(b => `<li class="desktop-response-block is-visible">${b}</li>`).join("")}</ul>` : ""}
                    ${session.response.result ? `<p class="desktop-response-block desktop-response-result is-visible">${session.response.result}</p>` : ""}
                `;
            }

            working.classList.remove("is-visible");
            statusEl.classList.remove("is-visible");
            sendBtn.classList.remove("is-running");
            textarea.value = "";
            transcript.scrollTop = 0;
        };

        // Send a custom message
        const sendMessage = async () => {
            const text = textarea.value.trim();
            if (!text) return;

            userInteracted = true;
            stop();
            textarea.value = "";

            if (!canvas.classList.contains("is-hidden")) {
                canvas.classList.add("is-hidden");
                transcript.classList.add("is-visible");
                projectSelector.classList.add("is-hidden");
                composer.classList.add("is-compact");
            }

            userBubble.textContent = text;
            userBubble.classList.add("is-confirmed");
            userRow.classList.add("is-visible");

            // Update session title
            const shortTitle = text.length > 24 ? text.slice(0, 24) + "…" : text;
            one(".desktop-title-text").textContent = shortTitle;
            one(".desktop-title-provider-icon").src = `/assets/providers/${activeProviderId}.svg`;
            newSessionRow.classList.add("is-visible", "is-active");
            one(".session-title-label", newSessionRow).textContent = shortTitle;
            one(".session-provider-img", newSessionRow).src = `/assets/providers/${activeProviderId}.svg`;

            // Status Sending
            sendBtn.classList.add("is-running");
            statusText.textContent = "Sending…";
            statusEl.classList.add("is-visible");
            await new Promise(r => setTimeout(r, 450));
            statusEl.classList.remove("is-visible");

            // Thinking
            working.classList.add("is-visible");
            startElapsed();
            await new Promise(r => setTimeout(r, 700));

            // Tool group
            toolGroup.style.display = "block";
            toolGroup.classList.remove("is-collapsed");
            toolGroup.classList.add("is-open");
            toolDisclosure.textContent = "▾";
            toolSummary.textContent = "3 tool calls";
            one("[data-tool-list]").innerHTML = `
                <div class="desktop-tool-row is-visible is-pending" data-dyn-tool="1">
                    <span class="desktop-icon desktop-i-document desktop-tool-icon"></span>
                    <span class="desktop-tool-label">Read</span>
                    <span class="desktop-tool-detail">site/src/components/DesktopDemo.astro</span>
                    <span class="desktop-tool-state"><span class="desktop-tool-spinner" style="display:grid">${Array.from({length:9}).map((_,i)=>`<i style="--matrix-index:${i}"></i>`).join("")}</span><span class="desktop-icon desktop-i-check desktop-tool-check"></span></span>
                </div>
                <div class="desktop-tool-row is-visible" data-dyn-tool="2">
                    <span class="desktop-icon desktop-i-pen desktop-tool-icon"></span>
                    <span class="desktop-tool-label">Edit</span>
                    <span class="desktop-tool-detail">site/src/components/DesktopDemo.astro</span>
                    <span class="desktop-tool-state"><span class="desktop-tool-spinner">${Array.from({length:9}).map((_,i)=>`<i style="--matrix-index:${i}"></i>`).join("")}</span><span class="desktop-icon desktop-i-check desktop-tool-check"></span></span>
                </div>
                <div class="desktop-tool-row is-visible" data-dyn-tool="3">
                    <span class="desktop-icon desktop-i-command desktop-tool-icon"></span>
                    <span class="desktop-tool-label">Run</span>
                    <span class="desktop-tool-detail">npm run build</span>
                    <span class="desktop-tool-state"><span class="desktop-tool-spinner">${Array.from({length:9}).map((_,i)=>`<i style="--matrix-index:${i}"></i>`).join("")}</span><span class="desktop-icon desktop-i-check desktop-tool-check"></span></span>
                </div>
            `;

            for (let i = 1; i <= 3; i++) {
                await new Promise(r => setTimeout(r, 600));
                const tr = one(`[data-dyn-tool="${i}"]`);
                if (tr) {
                    tr.classList.remove("is-pending");
                    tr.classList.add("is-done");
                    tr.querySelector(".desktop-tool-spinner").style.display = "none";
                    tr.querySelector(".desktop-tool-check").style.display = "block";
                }
            }

            await new Promise(r => setTimeout(r, 300));
            toolGroup.classList.remove("is-open");
            toolGroup.classList.add("is-collapsed");
            toolDisclosure.textContent = "▸";
            stopElapsed();
            working.classList.remove("is-visible");

            // Assistant reply
            one("[data-assistant-response]").innerHTML = `
                <p class="desktop-response-block is-visible">Completed: <strong>${text}</strong>.</p>
                <ul>
                    <li class="desktop-response-block is-visible">Loaded workspace configuration for <code>${activeWorkspace}</code>.</li>
                    <li class="desktop-response-block is-visible">Applied updates and validated build artifacts.</li>
                </ul>
                <p class="desktop-response-block desktop-response-result is-visible"><code>npm run build</code> passes. All pages generated cleanly.</p>
            `;
            sendBtn.classList.remove("is-running");
        };

        // Left sidebar toggle
        const toggleLeftSidebar = () => {
            isLeftSidebarOpen = !isLeftSidebarOpen;
            if (isLeftSidebarOpen) {
                sidebar.classList.remove("is-collapsed");
                main.classList.remove("is-full-left");
                sessionTitle.style.left = "272px";
            } else {
                sidebar.classList.add("is-collapsed");
                main.classList.add("is-full-left");
                sessionTitle.style.left = "184px";
            }
        };

        // Right pane toggle
        const toggleRightPane = (preferredTab = null) => {
            if (preferredTab) switchRightTab(preferredTab);
            if (!isRightPaneOpen) {
                isRightPaneOpen = true;
                rightPane.classList.remove("is-closed");
                main.classList.add("is-contract-right");
                one('[data-action="toggle-diff"]').classList.toggle("is-active", activeRightTab === "diff");
                one('[data-action="toggle-terminal"]').classList.toggle("is-active", activeRightTab === "terminal");
            } else if (preferredTab && activeRightTab !== preferredTab) {
                // Just switch tab
            } else {
                closeRightPane();
            }
        };

        const closeRightPane = () => {
            isRightPaneOpen = false;
            rightPane.classList.add("is-closed");
            main.classList.remove("is-contract-right");
            one('[data-action="toggle-diff"]').classList.remove("is-active");
            one('[data-action="toggle-terminal"]').classList.remove("is-active");
        };

        const switchRightTab = (tabName) => {
            activeRightTab = tabName;
            all("[data-pane-tab]").forEach(tab => tab.classList.toggle("is-active", tab.dataset.paneTab === tabName));
            all("[data-pane-view]").forEach(view => view.classList.toggle("is-active", view.dataset.paneView === tabName));
            one('[data-action="toggle-diff"]').classList.toggle("is-active", isRightPaneOpen && tabName === "diff");
            one('[data-action="toggle-terminal"]').classList.toggle("is-active", isRightPaneOpen && tabName === "terminal");
        };

        // Click event handling
        root.addEventListener("click", (e) => {
            // 1. Session item click
            const sessionEl = e.target.closest("[data-session-id]");
            if (sessionEl) {
                closeAllPopovers();
                switchSession(sessionEl.dataset.sessionId);
                return;
            }

            // 2. New Chat
            if (e.target.closest('[data-action="new-chat"]')) {
                closeAllPopovers();
                switchSession("new");
                return;
            }

            // 3. Left sidebar toggle
            if (e.target.closest('[data-action="toggle-left-sidebar"]')) {
                closeAllPopovers();
                toggleLeftSidebar();
                return;
            }

            // 4. Right pane toggles
            if (e.target.closest('[data-action="toggle-diff"]')) {
                closeAllPopovers();
                toggleRightPane("diff");
                return;
            }
            if (e.target.closest('[data-action="toggle-terminal"]')) {
                closeAllPopovers();
                toggleRightPane("terminal");
                return;
            }
            if (e.target.closest('[data-action="close-right-pane"]')) {
                closeRightPane();
                return;
            }
            const paneTab = e.target.closest("[data-pane-tab]");
            if (paneTab) {
                switchRightTab(paneTab.dataset.paneTab);
                return;
            }

            // 5. Tool header disclosure toggle
            if (e.target.closest("[data-tool-toggle]")) {
                const isOpen = toolGroup.classList.contains("is-open");
                if (isOpen) {
                    toolGroup.classList.remove("is-open");
                    toolGroup.classList.add("is-collapsed");
                    toolDisclosure.textContent = "▸";
                } else {
                    toolGroup.classList.remove("is-collapsed");
                    toolGroup.classList.add("is-open");
                    toolDisclosure.textContent = "▾";
                }
                return;
            }

            // 6. Popover triggers
            const trigger = e.target.closest("[data-menu-trigger]");
            if (trigger) {
                e.stopPropagation();
                const menu = trigger.dataset.menuTrigger;
                togglePopover(menu);
                return;
            }

            // 7. Model Picker: Provider tab switch
            const provTab = e.target.closest("[data-provider-tab]");
            if (provTab) {
                activeProviderId = provTab.dataset.providerTab;
                all("[data-provider-tab]").forEach(t => t.classList.toggle("is-active", t === provTab));
                renderModelList(modelSearchInput.value);
                return;
            }

            // 8. Model Picker: Model row select
            const modelRow = e.target.closest(".model-picker-row");
            if (modelRow) {
                activeModelId = modelRow.dataset.modelId;
                activeModelName = modelRow.dataset.modelName;
                all(".model-picker-row").forEach(r => r.classList.toggle("is-selected", r === modelRow));
                updateModelChip();
                closeAllPopovers();
                return;
            }

            // 9. Model Picker: Reasoning select
            const rRow = e.target.closest(".reasoning-row");
            if (rRow) {
                activeReasoning = rRow.dataset.reasoning;
                all(".reasoning-row").forEach(r => r.classList.toggle("is-selected", r === rRow));
                updateModelChip();
                return;
            }

            // 10. Workspace select
            const ws = e.target.closest("[data-workspace-select]");
            if (ws) {
                activeWorkspace = ws.dataset.workspaceSelect;
                one(".sidebar-workspace-name").textContent = activeWorkspace;
                one(".project-name-label").textContent = activeWorkspace;
                one(".desktop-session-target").textContent = activeWorkspace;
                all("[data-workspace-select]").forEach(r => r.classList.toggle("is-selected", r === ws));
                closeAllPopovers();
                return;
            }

            // 11. Permission select
            const perm = e.target.closest("[data-perm-select]");
            if (perm) {
                activePermission = perm.dataset.permSelect;
                one(".permission-label").textContent = activePermission;
                all("[data-perm-select]").forEach(r => r.classList.toggle("is-selected", r === perm));
                closeAllPopovers();
                return;
            }

            // 12. Branch select
            const br = e.target.closest("[data-branch-select]");
            if (br) {
                activeBranch = br.dataset.branchSelect;
                one(".branch-label").textContent = activeBranch;
                all("[data-branch-select]").forEach(r => r.classList.toggle("is-selected", r === br));
                closeAllPopovers();
                return;
            }

            // 13. Replay demo animation
            if (e.target.closest('[data-action="clear-chat"]')) {
                closeAllPopovers();
                userInteracted = false;
                completed = false;
                start();
                return;
            }

            // Close popover when clicking outside
            if (!e.target.closest(".desktop-popover") && !e.target.closest(".desktop-model-popover")) {
                closeAllPopovers();
            }
        });

        // Search input in model picker
        if (modelSearchInput) {
            modelSearchInput.addEventListener("input", () => {
                renderModelList(modelSearchInput.value);
            });
        }

        // Composer keydown
        textarea.addEventListener("keydown", (e) => {
            if (e.key === "Enter" && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });
        textarea.addEventListener("focus", () => {
            userInteracted = true;
        });

        sendBtn.addEventListener("click", () => {
            sendMessage();
        });

        // Keyboard shortcuts
        window.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                closeAllPopovers();
                return;
            }
            const isMod = e.metaKey || e.ctrlKey;
            if (isMod && (e.key === "b" || e.key === "B")) {
                e.preventDefault();
                toggleLeftSidebar();
            } else if (isMod && (e.key === "j" || e.key === "J")) {
                e.preventDefault();
                toggleRightPane("terminal");
            } else if (isMod && e.shiftKey && (e.key === "d" || e.key === "D")) {
                e.preventDefault();
                toggleRightPane("diff");
            } else if (isMod && (e.key === "n" || e.key === "N")) {
                e.preventDefault();
                switchSession("new");
            }
        });

        // Auto-run animation on viewport intersection
        let visible = false;
        const sync = () => {
            if (visible && !document.hidden) start();
            else stop();
        };

        new IntersectionObserver((entries) => {
            visible = entries[0].isIntersecting;
            sync();
        }, { threshold: 0.2 }).observe(root);

        document.addEventListener("visibilitychange", sync);
        reducedMotion.addEventListener("change", () => {
            stop();
            sync();
        });

        // Initial setup
        renderModelList();
        updateModelChip();
    })();
</script>
