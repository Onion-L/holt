    /* Right Pane */
    .desktop-right-pane { position: absolute; z-index: 6; top: 0; right: 0; bottom: 0; width: 340px; background: #0b0b0e; border-left: 1px solid rgba(255,255,255,.08); display: flex; flex-direction: column; transition: transform .22s cubic-bezier(.22,1,.36,1), opacity .18s; }
